{%- comment -%}
  Renders every "custom box" cart line as ONE block — the box is a group of
  ordinary line items, not a single product, but the shopper should never see
  that. Owned by sections/main-cart.liquid (with cart-item / cart-drawer-item).

  A line belongs to the box when it carries the hidden `_custom_box` property.
  That flag is the grouping key rather than the visible "Part of / Custom Box"
  pair, which is translated and so can't be matched on reliably.

  Each row's name and chip colour come from the line's own hidden properties
  (`_flavour_name`, `_flavour_colour`), stamped at add time by
  bundle-v2-builder.js. They can't be looked up here: a cart line has no route
  back to its flavour metaobject — `shop.metaobjects` isn't exposed to the
  storefront on this store, and the blend product itself knows nothing about
  flavours.

  The two surfaces have DIFFERENT internal structures, so this mirrors each one
  rather than sharing a prefix: the cart page is
  `.cart-item > .cart-item-details` (a grid that `.is-bundle` collapses to one
  column), the drawer is `.cart-drawer-item > .cart-drawer-item-info >
  .cart-drawer-item-text` + a separate `-controls` row. Using the page's class
  names in the drawer leaves the block with no flex sizing and it collapses to
  its content width.

  DELIBERATELY NOT EDITABLE. There is no quantity control, only a single remove
  that clears every line in the group at once (`data-remove-group`, handled by
  assets/cart-items.js). That is what keeps the 6-pack minimum from being eroded
  line by line in the cart — without it, blocking checkout would need a Shopify
  Function.

  Expects:
    - cart:    the cart object
    - variant: 'cart' (default) or 'drawer'

  Usage:
    {% render 'custom-box-line', cart: cart %}
    {% render 'custom-box-line', cart: cart, variant: 'drawer' %}
{%- endcomment -%}

{%- comment -%} Gather the group: line keys for the remove control, plus totals. {%- endcomment -%}
{%- assign box_keys = '' -%}
{%- assign box_total = 0 -%}
{%- assign box_compare = 0 -%}
{%- assign box_count = 0 -%}
{%- assign box_plan = blank -%}
{%- for item in cart.items -%}
  {%- if item.properties['_custom_box'] == blank -%}{%- continue -%}{%- endif -%}
  {%- assign box_keys = box_keys | append: item.key | append: ',' -%}
  {%- assign box_total = box_total | plus: item.final_line_price -%}
  {%- assign box_compare = box_compare | plus: item.original_line_price -%}
  {%- assign box_count = box_count | plus: item.quantity -%}
  {%- if item.selling_plan_allocation -%}
    {%- assign box_plan = item.selling_plan_allocation.selling_plan.name -%}
  {%- endif -%}
{%- endfor -%}
{%- assign box_keys = box_keys | split: ',' | join: ',' -%}

{%- if box_count > 0 -%}
  {%- if variant == 'drawer' -%}
    <div class="cart-drawer-item is-bundle custom-box-line">
      <div class="cart-drawer-item-info">
        <div class="cart-drawer-item-text">
          <p class="cart-drawer-item-title text-ui">{{ 'sections.bundle_builder.box_property_value' | t }}</p>
          <p class="cart-drawer-item-subtitle">
            {{ 'sections.bundle_builder.box_pack_count' | t: count: box_count }}
          </p>

          {% render 'custom-box-rows', cart: cart %}
        </div>

        {%- comment -%} Mirrors the drawer's qty + price row, minus the quantity control. {%- endcomment -%}
        <div class="cart-drawer-item-controls">
          <button
            type="button"
            class="custom-box-remove inline-link text-ui"
            data-remove-group="{{ box_keys }}"
            aria-label="{{ 'sections.bundle_builder.remove_box' | t }}"
          >
            {{ 'cart.general.remove' | t }}
          </button>
          <span class="cart-drawer-item-price text-ui">
            {%- if box_compare != box_total -%}
              <s class="custom-box-compare">{{ box_compare | money }}</s>
            {%- endif -%}
            {{ box_total | money }}
          </span>
        </div>

        {%- if box_plan != blank -%}
          <p class="cart-drawer-item-subscription">{{ box_plan }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="cart-item is-bundle custom-box-line">
      <div class="cart-item-details">
        <p class="cart-item-title">{{ 'sections.bundle_builder.box_property_value' | t }}</p>
        <p class="cart-item-variant text-mini">
          {{ 'sections.bundle_builder.box_pack_count' | t: count: box_count }}
        </p>

        {%- if box_plan != blank -%}
          <p class="cart-item-subscription text-ui">{{ box_plan }}</p>
        {%- endif -%}

        {% render 'custom-box-rows', cart: cart %}

        <p class="cart-item-price">
          {%- if box_compare != box_total -%}
            <s class="cart-item-compare-price">{{ box_compare | money }}</s>
          {%- endif -%}
          {{ box_total | money }}
        </p>

        <div class="cart-item-actions">
          <button
            type="button"
            class="cart-item-remove button"
            data-remove-group="{{ box_keys }}"
            aria-label="{{ 'sections.bundle_builder.remove_box' | t }}"
          >
            {{ 'cart.general.remove' | t }}
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* The flavour rows carry the visual, so the group needs a little more air than
     a normal line: the rows sit apart from the title above and the price below
     rather than butting up against them. */
  .custom-box-line .bundle-line {
    margin: var(--spacing-xxs) 0;
  }

  /* Drawer: remove sits left, price right — same row the quantity stepper would
     have occupied, so the block keeps the drawer's rhythm. */
  .custom-box-line .custom-box-remove {
    flex: 0 0 auto;
  }

  .custom-box-compare {
    color: var(--color-text-light);
    margin-right: var(--spacing-xxs);
  }
{% endstylesheet %}
