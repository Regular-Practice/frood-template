{%- comment -%}
  Recipe Card — owned by sections/main-recipes.liquid.

  Clicking a card opens an inline <recipe-modal>: a two-column dialog with the
  recipe video on the left (portrait, bespoke media-chrome `chrome: 'minimal'`
  controls) and info card(s) on the right. Stacks video-over-cards below 900px.

  Expects: recipe (metaobject) with handles:
    name, image, duration, description, video   (rendered today)
    products (list of product references)       (optional — lights up the
                                                 "Made with" card, one row per
                                                 product, when present)
{%- endcomment -%}

<recipe-modal class="recipe-card">
  <button type="button" class="recipe-card-link" aria-haspopup="dialog">
    <div class="recipe-card-image">
      {%- if recipe.image != blank -%}
        {{
          recipe.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw',
            width: recipe.image.width,
            height: recipe.image.height
        }}
      {%- else -%}
        <div class="recipe-card-placeholder" aria-hidden="true"></div>
      {%- endif -%}
    </div>

    <div class="recipe-card-info">
      <div class="recipe-card-title-row">
        <h3 class="text-ui recipe-card-name">{{ recipe.name }}</h3>
        {%- if recipe.duration != blank -%}
          <p class="text-h1 recipe-card-duration">{{ recipe.duration }}</p>
        {%- endif -%}
      </div>
      {%- if recipe.description != blank -%}
        <div class="text-body recipe-card-description">
          {{ recipe.description | metafield_tag }}
        </div>
      {%- endif -%}
    </div>
  </button>

  <div class="recipe-modal" role="dialog" aria-modal="true" aria-label="{{ recipe.name | escape }}" hidden>
    <button type="button" class="recipe-modal-close" aria-label="{{ 'recipes.modal.close' | t }}">
      {% render 'icon-close' %}
    </button>

    <div class="recipe-modal-inner">
      {%- assign recipe_video = recipe.video.value -%}
      {%- if recipe_video != blank -%}
        <div class="recipe-modal-video">
          {%- comment -%}
            No `autoplay` and preload:'none' — the video is hidden until the
            modal opens, at which point recipe-modal.js calls play(). This keeps
            hidden cards from fetching video bytes on page load and guarantees
            the video only ever plays while the modal is open.
          {%- endcomment -%}
          {% render 'video',
            media: recipe_video,
            controls: true,
            chrome: 'minimal',
            preload: 'none',
            loop: true,
            playsinline: true,
            label: recipe.name
          %}
        </div>
      {%- endif -%}

      <div class="recipe-modal-info">
        <div class="recipe-info-card">
          <h2 class="text-ui recipe-info-title">{{ recipe.name }}</h2>

          {%- if recipe.description != blank -%}
            <div class="text-body recipe-info-description">
              {{ recipe.description | metafield_tag }}
            </div>
          {%- endif -%}

          {%- if recipe.duration != blank -%}
            <hr class="recipe-info-rule">
            {%- comment -%}
              Only `duration` exists on the metaobject today; a `serves` (and any
              further) detail joins this list once those fields are added.
            {%- endcomment -%}
            <ul class="text-body recipe-info-details">
              <li>{{ recipe.duration }}</li>
            </ul>
          {%- endif -%}
        </div>

        {%- comment -%}
          "Made with" product card — lights up when the recipes metaobject has a
          `products` field (a LIST of product references). Loops every linked
          product, rendering each one's thumbnail, title and a VIEW link, in the
          order curated on the recipe. Empty or absent → the card is omitted.
        {%- endcomment -%}
        {%- assign made_with_products = recipe.products.value -%}
        {%- if made_with_products != blank -%}
          <div class="recipe-madewith-card">
            <p class="text-body recipe-madewith-label">{{ 'recipes.modal.made_with' | t }}</p>
            {%- for product in made_with_products -%}
              <a class="recipe-madewith-product" href="{{ product.url }}">
                <span class="recipe-madewith-image">
                  {%- comment -%}
                    First media's preview image — when the product leads with a
                    video this is its poster frame, so the thumbnail still shows
                    something. (featured_image is image-only and would be blank
                    for a video-first product.)
                  {%- endcomment -%}
                  {%- assign made_with_thumb = product.featured_media.preview_image -%}
                  {%- if made_with_thumb != blank -%}
                    {{
                      made_with_thumb
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        width: made_with_thumb.width,
                        height: made_with_thumb.height,
                        alt: product.title
                    }}
                  {%- endif -%}
                </span>
                <span class="recipe-madewith-text">
                  <span class="text-ui recipe-madewith-name">{{ product.title }}</span>
                  <span class="text-h1 recipe-madewith-view">{{ 'recipes.modal.view' | t }}</span>
                </span>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</recipe-modal>

{% stylesheet %}
  .recipe-card-link {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-s);
    text-align: left;
  }

  .recipe-card-image {
    flex: 0 0 50%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-bg-dark);
    border-radius: var(--rad-s);
  }

  .recipe-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recipe-card-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-border);
  }

  .recipe-card-info {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-xs);
  }

  .recipe-card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-xs);
  }

  /* Mobile (base): the WHOLE dialog scrolls. The video fills the width and is
     height-capped so it fits the viewport with the info card peeking below.
     overflow-x is clipped because `overflow-y: auto` alone promotes overflow-x
     to `auto` too (per spec), letting a sub-pixel-wide video trigger a stray
     horizontal scroll. scrollbar-gutter reserves space on BOTH edges so the
     vertical scrollbar can't unbalance the left/right padding. Desktop overrides
     to a centred, non-scrolling two-column layout (single media query below). */
  .recipe-modal {
    position: fixed;
    inset: 0;
    z-index: 999;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable both-edges;
    -webkit-overflow-scrolling: touch;
    background-color: var(--color-overlay);
  }

  /* Frosted backdrop on its own layer, pinned to the viewport (position:fixed,
     not absolute) so it keeps covering the screen while the dialog scrolls
     rather than scrolling away with the content. Kept off the video's ancestors
     to avoid a GPU compositing bug that renders <video> solid black when an
     ancestor is backdrop-filtered. */
  .recipe-modal::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 0;
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
  }

  .recipe-modal[hidden] {
    display: none;
  }

  /* Icon-only close — no background, matching the drawer close buttons: muted
     at rest, full text colour on hover. Fixed to the viewport corner so it
     stays reachable while the dialog scrolls. */
  .recipe-modal-close {
    position: fixed;
    top: var(--spacing-s);
    right: var(--spacing-s);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xxs);
    color: var(--color-text-accent);
    transition: color var(--transition-fast);
  }

  .recipe-modal-close:hover {
    color: var(--color-text);
  }

  .recipe-modal-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
    padding: var(--spacing-xs) var(--spacing-xs) var(--spacing-m);
  }

  /* Video frame — clipped, controls overlaid (no beige frame; the v2 design
     sits the controls directly on the video). Full-bleed on mobile. */
  .recipe-modal-video {
    flex: 0 0 auto;
    display: flex;
    align-self: stretch;
    overflow: hidden;
    border-radius: var(--rad-s);
  }

  /* Mobile: the video fills the column width and is capped at 88svh so it always
     fits the viewport (svh, not vh, stays correct under the mobile browser bar)
     while leaving just the top edge of the info card peeking below. object-fit:
     cover keeps it flush to the card's edges — matching the Figma full-frame
     treatment — at the cost of a small top/bottom crop. */
  .recipe-modal-video media-controller {
    display: block;
    width: 100%;
    height: 88vh;
    height: 88svh;
    line-height: 0;
  }

  .recipe-modal-video media-controller video[slot="media"] {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recipe-modal-info {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
  }

  /* Desktop: centred, non-scrolling two columns — video left (height-driven, so
     the frame matches the video's true aspect with no letterbox; rounded), the
     348px info column right, both top-aligned. */
  @media (min-width: 900px) {
    .recipe-modal {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--spacing-m);
      overflow: hidden;
      scrollbar-gutter: auto;
    }

    .recipe-modal-close {
      top: var(--spacing-m);
      right: var(--spacing-m);
    }

    .recipe-modal-inner {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      max-width: 100%;
      padding: 0;
    }

    .recipe-modal-video {
      align-self: flex-start;
    }

    .recipe-modal-video media-controller {
      display: inline-block;
      width: auto;
      height: auto;
      max-width: 100%;
    }

    .recipe-modal-video media-controller video[slot="media"] {
      width: auto;
      height: 85vh;
      max-width: 100%;
      max-height: 85vh;
      object-fit: contain;
    }

    .recipe-modal-info {
      width: 348px;
    }
  }

  .recipe-info-card,
  .recipe-madewith-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs);
    background-color: var(--color-bg);
    border-radius: var(--rad-s);
  }

  .recipe-info-rule {
    width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .recipe-info-details {
    margin: 0;
    padding-left: 1.25em;
    list-style: disc;
    color: var(--color-text-accent);
  }

  .recipe-info-details li + li {
    margin-top: var(--spacing-xxs);
  }

  .recipe-madewith-label {
    color: var(--color-text-accent);
  }

  .recipe-madewith-product {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-xxs);
  }

  .recipe-madewith-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .recipe-madewith-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .recipe-madewith-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xxs);
    text-align: left;
  }
{% endstylesheet %}
