{%- comment -%}
  Recipe Card — owned by sections/main-recipes.liquid.

  Clicking a card opens an inline <recipe-modal>: a two-column dialog with the
  recipe video on the left (portrait, bespoke media-chrome `chrome: 'minimal'`
  controls) and info card(s) on the right. Stacks video-over-cards below 900px.

  Expects: recipe (metaobject) with handles:
    name, image, duration, description, video   (rendered today)
    made_with (product reference)               (optional — lights up the
                                                 "Made with" card when present)
{%- endcomment -%}

<recipe-modal class="recipe-card">
  <button type="button" class="recipe-card-link" aria-haspopup="dialog">
    <div class="recipe-card-image">
      {%- if recipe.image != blank -%}
        {{
          recipe.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw',
            width: recipe.image.width,
            height: recipe.image.height
        }}
      {%- else -%}
        <div class="recipe-card-placeholder" aria-hidden="true"></div>
      {%- endif -%}
    </div>

    <div class="recipe-card-info">
      <div class="recipe-card-title-row">
        <h3 class="text-ui recipe-card-name">{{ recipe.name }}</h3>
        {%- if recipe.duration != blank -%}
          <p class="text-h1 recipe-card-duration">{{ recipe.duration }}</p>
        {%- endif -%}
      </div>
      {%- if recipe.description != blank -%}
        <div class="text-body recipe-card-description">
          {{ recipe.description | metafield_tag }}
        </div>
      {%- endif -%}
    </div>
  </button>

  <div class="recipe-modal" role="dialog" aria-modal="true" aria-label="{{ recipe.name | escape }}" hidden>
    <button type="button" class="recipe-modal-close" aria-label="{{ 'recipes.modal.close' | t }}">
      {% render 'icon-close' %}
    </button>

    <div class="recipe-modal-inner">
      {%- assign recipe_video = recipe.video.value -%}
      {%- if recipe_video != blank -%}
        <div class="recipe-modal-video">
          {% render 'video',
            media: recipe_video,
            controls: true,
            chrome: 'minimal',
            autoplay: true,
            loop: true,
            playsinline: true,
            label: recipe.name
          %}
        </div>
      {%- endif -%}

      <div class="recipe-modal-info">
        <div class="recipe-info-card">
          <h2 class="text-ui recipe-info-title">{{ recipe.name }}</h2>

          {%- if recipe.description != blank -%}
            <div class="text-body recipe-info-description">
              {{ recipe.description | metafield_tag }}
            </div>
          {%- endif -%}

          {%- if recipe.duration != blank -%}
            <hr class="recipe-info-rule">
            {%- comment -%}
              Only `duration` exists on the metaobject today; a `serves` (and any
              further) detail joins this list once those fields are added.
            {%- endcomment -%}
            <ul class="text-body recipe-info-details">
              <li>{{ recipe.duration }}</li>
            </ul>
          {%- endif -%}
        </div>

        {%- comment -%}
          "Made with" product card — dormant until the recipes metaobject gains a
          product-reference field (expected handle: `made_with`). When present it
          renders the linked product's thumbnail, title and a VIEW link. No other
          code change needed to switch it on.
        {%- endcomment -%}
        {%- assign made_with = recipe.made_with.value -%}
        {%- if made_with != blank -%}
          <div class="recipe-madewith-card">
            <p class="text-body recipe-madewith-label">{{ 'recipes.modal.made_with' | t }}</p>
            <a class="recipe-madewith-product" href="{{ made_with.url }}">
              <span class="recipe-madewith-image">
                {%- if made_with.featured_image != blank -%}
                  {{
                    made_with.featured_image
                    | image_url: width: 176
                    | image_tag: loading: 'lazy', width: 88, height: 88, alt: made_with.title
                  }}
                {%- endif -%}
              </span>
              <span class="recipe-madewith-text">
                <span class="text-ui recipe-madewith-name">{{ made_with.title }}</span>
                <span class="text-h1 inline-link recipe-madewith-view">{{ 'recipes.modal.view' | t }}</span>
              </span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</recipe-modal>

{% stylesheet %}
  .recipe-card-link {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-s);
    text-align: left;
  }

  .recipe-card-image {
    flex: 0 0 50%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-bg-dark);
    border-radius: var(--rad-s);
  }

  .recipe-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recipe-card-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-border);
  }

  .recipe-card-info {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-xs);
  }

  .recipe-card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-xs);
  }

  .recipe-modal {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-m);
    background-color: var(--color-overlay);
  }

  /* Frosted backdrop on a separate layer BEHIND the video. Keeping
     backdrop-filter off the video's ancestors avoids a GPU compositing bug
     that renders <video> solid black when an ancestor is backdrop-filtered. */
  .recipe-modal::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
  }

  .recipe-modal[hidden] {
    display: none;
  }

  /* Icon-only close — no background, matching the drawer close buttons:
     muted at rest, full text colour on hover. */
  .recipe-modal-close {
    position: absolute;
    top: var(--spacing-m);
    right: var(--spacing-m);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xxs);
    color: var(--color-text-accent);
    transition: color var(--transition-fast);
  }

  .recipe-modal-close:hover {
    color: var(--color-text);
  }

  /* Mobile: video then info cards, stacked, whole modal body scrolls. */
  .recipe-modal-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-s);
    width: 100%;
    max-height: 100%;
    overflow-y: auto;
  }

  /* Desktop: video left (height-driven), 348px info column right, top-aligned. */
  @media (min-width: 900px) {
    .recipe-modal-inner {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      width: auto;
      max-width: 100%;
      overflow: visible;
    }
  }

  /* Video frame — rounded clip with controls overlaid (no beige frame; the v2
     design sits the controls directly on the video). */
  .recipe-modal-video {
    flex: 0 0 auto;
    display: flex;
    align-self: center;
    border-radius: var(--rad-s);
    overflow: hidden;
  }

  /* Mobile: shrink-wrap the video within (100% wide, 60vh tall) preserving its
     own aspect — no pillarbox/letterbox — leaving room for the cards below. */
  .recipe-modal-video media-controller {
    display: inline-block;
    max-width: 100%;
    line-height: 0;
  }

  .recipe-modal-video media-controller video[slot="media"] {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
  }

  /* Desktop: height-driven so the frame matches the video's true aspect ratio
     (no dependency on a metafield aspect_ratio, no letterbox strip). */
  @media (min-width: 900px) {
    .recipe-modal-video {
      align-self: flex-start;
    }

    .recipe-modal-video media-controller video[slot="media"] {
      width: auto;
      height: 85vh;
      max-width: 100%;
      max-height: 85vh;
    }
  }

  .recipe-modal-info {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
    width: 100%;
  }

  @media (min-width: 900px) {
    .recipe-modal-info {
      width: 348px;
    }
  }

  .recipe-info-card,
  .recipe-madewith-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs);
    background-color: var(--color-bg);
    border-radius: var(--rad-s);
  }

  .recipe-info-rule {
    width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .recipe-info-details {
    margin: 0;
    padding-left: 1.25em;
    list-style: disc;
    color: var(--color-text-accent);
  }

  .recipe-info-details li + li {
    margin-top: var(--spacing-xxs);
  }

  .recipe-madewith-label {
    color: var(--color-text-accent);
  }

  .recipe-madewith-product {
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
  }

  .recipe-madewith-image {
    flex: 0 0 88px;
    width: 88px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .recipe-madewith-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .recipe-madewith-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
  }
{% endstylesheet %}
