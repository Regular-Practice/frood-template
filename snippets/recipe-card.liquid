{%- comment -%}
  Recipe Card — owned by sections/main-recipes.liquid.
  The whole card links to the recipe's own page (recipe.system.url): the
  `.recipe-card-link` anchor's stretched ::after overlay (see stylesheet) makes a
  click anywhere on the card follow it. The visible "Watch →" label stays as the
  affordance.

  Expects: recipe (metaobject) with handles: name, image, description.
  Optional: stacked (bool) — below 900px, lay the card out image-over-text with
  the description visible (used by the recipe page's related list).
{%- endcomment -%}

<article class="recipe-card{% if stacked %} stacked{% endif %}">
  <div class="recipe-card-image">
    {%- if recipe.image != blank -%}
      {{
        recipe.image
        | image_url: width: 1200
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw',
          width: recipe.image.width,
          height: recipe.image.height
      }}
    {%- else -%}
      <div class="recipe-card-placeholder" aria-hidden="true"></div>
    {%- endif -%}
  </div>

  <div class="recipe-card-info">
    <h3 class="text-ui recipe-card-name">{{ recipe.name }}</h3>

    {%- if recipe.description != blank -%}
      <div class="text-body recipe-card-description">
        {{ recipe.description | metafield_tag }}
      </div>
    {%- endif -%}

    <a href="{{ recipe.system.url }}" class="recipe-card-link text-h1">
      <span>{{ 'recipes.card.watch' | t }}</span>
      {% render 'icon-arrow', class: 'recipe-card-watch-icon' %}
    </a>
  </div>
</article>

{% stylesheet %}
  /* The card is the flex row (image left, info right) AND the link target:
     the `.recipe-card-link` button stretches a transparent ::after across the
     whole card (see below), so a click anywhere follows the link. position:
     relative anchors that overlay; the hover/focus tint highlights the card as
     one clickable unit. The xxs padding lets that tint frame the image + text
     evenly rather than only lighting up the info column. */
  .recipe-card {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-s);
    padding: 0;
    text-align: left;
    border-radius: var(--rad-s);
    transition: background-color var(--transition-fast);
  }

  @media (min-width: 900px) {
    .recipe-card {
      padding: var(--spacing-xxs);
    }
  }

  .recipe-card:hover {
    background-color: var(--color-accent-light);
  }

  /* Keyboard focus lands on the (visually small) trigger button, but the whole
     card is the target — so move the focus ring onto the card and tint it too.
     The button's own outline is suppressed below. */
  .recipe-card:has(.recipe-card-link:focus-visible) {
    background-color: var(--color-accent-light);
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .recipe-card-image {
    flex: 0 0 50%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-bg-dark);
    border-radius: var(--rad-s);
  }

  .recipe-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recipe-card-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-border);
  }

  .recipe-card-info {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-xxxs);
  }

  @media (min-width: 900px) {
    .recipe-card-info {
      gap: var(--spacing-xs);
    }
  }

  /* Hide the description on mobile/tablet; reveal it at desktop where there's
     room for the longer copy alongside the image. */
  .recipe-card-description {
    display: none;
  }

  @media (min-width: 900px) {
    .recipe-card-description {
      display: block;
    }
  }

  /* Watch → trigger: .text-h1 typography (small uppercase) + inline arrow.
     Self-aligns to the left of the info column, sits below the description.
     Its ::after is a transparent overlay stretched across the whole card
     (anchored by .recipe-card's position:relative) so the entire card — image
     included — is one click target. The overlay carries NO background (it sits
     above the image/text); the visible hover tint lives on .recipe-card. */
  .recipe-card-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xxs);
    cursor: pointer;
  }

  .recipe-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* The card shows the focus ring instead — see .recipe-card above. */
  .recipe-card-link:focus-visible {
    outline: none;
  }

  .recipe-card-watch-icon {
    width: 1em;
    height: auto;
    display: block;
    transition: transform var(--transition-fast);
  }

  .recipe-card:hover .recipe-card-watch-icon,
  .recipe-card:has(.recipe-card-link:focus-visible) .recipe-card-watch-icon {
    transform: translateX(var(--spacing-xxs));
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe-card-watch-icon { transition: none; }
    .recipe-card:hover .recipe-card-watch-icon,
    .recipe-card:has(.recipe-card-link:focus-visible) .recipe-card-watch-icon { transform: none; }
  }

  /* Stacked variant (recipe page "related" list): below 900px the image sits
     above the text and the description is shown, as in the mobile design. */
  @media (max-width: 899.98px) {
    .recipe-card.stacked {
      flex-direction: column;
      align-items: stretch;
    }

    .recipe-card.stacked .recipe-card-image {
      flex: none;
      width: 100%;
    }

    .recipe-card.stacked .recipe-card-info {
      gap: var(--spacing-xs);
    }

    .recipe-card.stacked .recipe-card-description {
      display: block;
    }
  }
{% endstylesheet %}
