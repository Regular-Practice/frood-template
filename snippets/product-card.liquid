{%- comment -%}
  Renders a product card for collection grids and featured collections.
  Expects: product (product object)

  The thumbnail is driven entirely by the FIRST media item (product.media.first),
  honouring the merchant's media order:

    - video  → the video's preview_image is the still; a <product-card-hover-video>
               overlay plays the mp4 on hover.
    - image  → that image is the still; if the SECOND media is also an image it
               cross-fades in on hover.
    - other  → fall back to product.featured_image, else a placeholder.

  hover_video_src is resolved once here so the body and the conditional <script>
  tag can both reference it — we only load product-card-hover-video.js for cards
  whose first media is a playable video.

  (3D / GLB model support was removed for now; assets/product-card-stage.js and
  the three.js import map are left in place so it can be re-wired later.)
{%- endcomment -%}

{%- assign first_media = product.media.first -%}
{%- assign hover_video_src = nil -%}
{%- if first_media.media_type == 'video' -%}
  {%- assign hover_video_src = first_media.sources | where: 'format', 'mp4' | sort: 'width' | first -%}
{%- endif -%}

<article class="product-card">
  <div class="product-card-image aspect-{{ settings.product_card_aspect_ratio }}">
    <a href="{{ product.url }}" class="product-card-image-link" tabindex="-1" aria-hidden="true">
      {%- if first_media.media_type == 'video' -%}
        {%- assign video_poster = first_media.preview_image | default: product.featured_image -%}
        {%- if video_poster -%}
          {{
            video_poster
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 1200px) 25vw, (min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw',
              width: video_poster.width,
              height: video_poster.height
          }}
        {%- endif -%}

        {%- if hover_video_src -%}
          {%- comment -%}
            Hover overlay. The poster <img> above is the always-visible still.
            This <video> sits over it at opacity:0 and fades in via the
            JS-set .is-active class. JS handles data-src→src promotion after an
            80ms hover-intent debounce, play forward on enter, and play in
            reverse back to frame 0 on leave (then fades to the poster).
            preload="none" + data-src means zero MP4 bytes per card on initial
            page load — only fetched when the user actually settles on a card.
          {%- endcomment -%}
          <product-card-hover-video class="product-card-hover-video">
            <video
              class="product-card-video"
              muted
              playsinline
              preload="none"
              tabindex="-1"
              aria-hidden="true"
            >
              <source data-src="{{ hover_video_src.url }}" type="video/mp4">
            </video>
          </product-card-hover-video>
        {%- endif -%}
      {%- elsif first_media.media_type == 'image' -%}
        {{
          first_media
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 1200px) 25vw, (min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw',
            width: first_media.width,
            height: first_media.height
        }}

        {%- comment -%}
          Hover still — the SECOND media item, but only when it's an image.
          A non-image second item (video/model) gets no hover treatment; the
          card just shows the static first image.
        {%- endcomment -%}
        {%- if product.media.size > 1 and product.media[1].media_type == 'image' -%}
          {{
            product.media[1]
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 1200px) 25vw, (min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw',
              width: product.media[1].width,
              height: product.media[1].height,
              class: 'product-card-image-hover'
          }}
        {%- endif -%}
      {%- elsif product.featured_image -%}
        {%- comment -%}
          First media is something we don't render on the card (model, external
          video, …). Fall back to the product's featured image.
        {%- endcomment -%}
        {{
          product.featured_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 1200px) 25vw, (min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw',
            width: product.featured_image.width,
            height: product.featured_image.height
        }}
      {%- else -%}
        <div class="product-card-placeholder"></div>
      {%- endif -%}
    </a>

    {%- comment -%}
      Hover-revealed quick actions. Sibling of .product-card-image-link (NOT
      a child) — nesting a <button>/<form> inside an <a> is invalid HTML.
      Positioned absolutely at the bottom of the image area. CSS flips
      pointer-events so the underlying image-link receives clicks when actions
      are hidden, and the buttons take their own clicks when revealed on
      hover. Animation mirrors the header nav stagger pattern.
    {%- endcomment -%}
    {%- assign first_variant = product.selected_or_first_available_variant -%}
    <div class="product-card-actions">
      <a href="{{ product.url }}" class="button secondary">{{ 'products.product.view' | t }}</a>

      {%- if first_variant -%}
        <product-card-quick-add data-added-message="{{ 'products.product.added_to_cart' | t: product: product.title }}">
          <form action="/cart/add" method="post">
            <input type="hidden" name="id" value="{{ first_variant.id }}">
            <button
              type="submit"
              class="button"
              {%- unless product.available %} disabled aria-disabled="true"{%- endunless -%}
            >
              {{ 'products.product.add' | t }}
            </button>
          </form>
        </product-card-quick-add>
      {%- endif -%}
    </div>

    {%- comment -%} Badge priority: Sold out > Sale. The "new" auto-detect was removed. {%- endcomment -%}
    {%- liquid
      assign badge_text = ''
      assign badge_type = ''

      unless product.available
        assign badge_text = 'products.product.sold_out' | t
        assign badge_type = 'sold-out'
      endunless

      if badge_text == '' and product.compare_at_price > product.price
        assign badge_text = 'products.product.sale' | t
        assign badge_type = 'sale'
      endif
    -%}

    {%- if badge_text != '' -%}
      <span class="product-card-badge {{ badge_type }}">{{ badge_text }}</span>
    {%- endif -%}
  </div>

  <a href="{{ product.url }}" class="product-card-info">
    <h3 class="product-card-title text-ui">{{ product.title }}</h3>

    <div class="product-card-meta text-ui">
      {% render 'product-price', product: product %}

      {%- assign current_variant = product.selected_or_first_available_variant -%}
      {%- if current_variant.weight > 0 -%}
        <span class="product-card-separator" aria-hidden="true">|</span>
        <span class="product-card-weight">
          {{- current_variant.weight | round -}}{{- current_variant.weight_unit -}}
        </span>
      {%- endif -%}
    </div>
  </a>
</article>

{%- comment -%}
  Conditional script loading. Only cards whose first media is a playable video
  load product-card-hover-video.js — pages with no hover videos skip it. The
  browser dedupes the fetch when multiple cards emit the same script tag.
{%- endcomment -%}
{%- if hover_video_src -%}
  <script type="module" src="{{ 'product-card-hover-video.js' | asset_url }}"></script>
{%- endif -%}

{%- if first_variant -%}
  <script type="module" src="{{ 'product-card-quick-add.js' | asset_url }}"></script>
{%- endif -%}

{% stylesheet %}
  .product-card-info {
    padding-top: var(--spacing-s);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xxxs);
    text-align: center;
  }

  .product-card-title {
    margin: 0;
  }

  .product-card-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xxxs);
  }

  /* In product cards, price uses full body-ui styling (dark) rather than the muted .text-light */
  .product-card-meta .text-light {
    color: var(--color-text);
  }

  .product-card-image {
    position: relative;
    overflow: hidden;
    border-radius: var(--rad-s);
  }

  .product-card-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-border);
  }

  /* Hover-revealed quick actions overlay. Sits at the bottom of the image
     area (over the image/video). Animation mirrors the header nav stagger
     (sections/header.liquid §) — buttons start translateY(-6px) + opacity 0
     and ease into place with a 40ms stagger when the card is hovered.
     pointer-events flip so the underlying image-link receives clicks when
     actions are hidden, and the buttons receive them when revealed. Only on
     hover-capable devices — touch users never see this layer and tap straight
     through to the PDP via the image-link. */
  .product-card-actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    gap: var(--spacing-xxs);
    justify-content: center;
    padding: var(--spacing-s);
    pointer-events: none;
    z-index: 2;
  }

  /* The ADD button is nested two levels deep (custom element → form → button)
     while VIEW is a direct flex child of .product-card-actions. Left as block,
     the button would sit in a line box (baseline-aligned, with strut/descender
     space) and land a couple of px off from VIEW. Making the wrapper and form
     flex containers lets the button stretch through the chain to the same
     cross-size as VIEW, so the two align exactly. */
  .product-card-actions product-card-quick-add,
  .product-card-actions product-card-quick-add form {
    display: flex;
  }

  /* Each child gets the nav-item-in motion: small slide down + fade. Hidden
     by default, revealed on .product-card:hover. transition-delay creates the
     stagger (VIEW first, ADD 40ms later). */
  .product-card-actions > * {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .product-card-actions > *:nth-child(2) {
    transition-delay: 0.04s;
  }

  @media (hover: hover) {
    .product-card:hover .product-card-actions {
      pointer-events: auto;
    }

    .product-card:hover .product-card-actions > * {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Touch devices have no hover — show VIEW + ADD by default so users can
     act without a hover trigger. No stagger animation (no reveal moment). */
  @media (hover: none) {
    .product-card-actions {
      pointer-events: auto;
    }

    .product-card-actions > * {
      opacity: 1;
      transform: translateY(0);
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card-actions > * {
      transition: none;
    }
  }

  /* Hover video — sits over the always-visible <img>, faded in on
     .product-card:hover. Mirrors .product-card-image-hover (base.css §13) so
     the image-hover fallback and the video-hover treatment look identical.
     pointer-events: none keeps clicks routing to the underlying link. */
  .product-card-hover-video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--transition-fast);
    pointer-events: none;
  }

  .product-card-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Visibility is JS-driven (.is-active) rather than :hover so the video stays
     on screen through the reverse-on-exit rewind, then fades back to the poster
     when the rewind reaches frame 0. See assets/product-card-hover-video.js. */
  @media (hover: hover) {
    .product-card-hover-video.is-active {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card-hover-video {
      transition: none;
    }
    .product-card-hover-video.is-active {
      opacity: 0;
    }
  }

  .product-card-badge {
    position: absolute;
    top: var(--spacing-s);
    right: var(--spacing-s);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--font-size-mini);
    line-height: var(--line-height-mini);
    padding: var(--spacing-xxs) var(--spacing-xs);
  }

  .product-card-badge.sale {
    background: var(--color-accent);
    color: var(--color-text);
  }

{% endstylesheet %}
