{% comment %}
  Native subscription / one-time selector.

  Reads the product's Shopify selling plans (created by Recharge as native
  selling-plan groups) and renders a Frood-styled "One time vs Subscription"
  picker plus a delivery-frequency dropdown. On selection it writes the chosen
  selling_plan id into a hidden input that product-form.js includes in the
  /cart/add.js POST. Subscriptions still bill entirely through Recharge — this
  only replaces the on-page picker (Recharge's own widget is sealed in shadow
  DOM and can't be styled to match Frood).

  Renders nothing if the product has no selling plans, so non-subscription
  products are unaffected.

  Expects: product (product object)
  Owner: sections/main-product.liquid
{% endcomment %}

{%- assign variant = product.selected_or_first_available_variant -%}

{%- if variant.selling_plan_allocations.size > 0 -%}
  {%- assign first_alloc = variant.selling_plan_allocations | first -%}
  {%- comment -%} Discount % from the first allocation (e.g. 1200→1080 = 10%). {%- endcomment -%}
  {%- assign discount = first_alloc.compare_at_price | minus: first_alloc.price | times: 100.0 | divided_by: first_alloc.compare_at_price | round -%}

  <product-subscription
    class="product-subscription"
    data-onetime-money="{{ variant.price | money }}"
    data-onetime-cents="{{ variant.price }}"
    data-money-format="{{ shop.money_format }}"
    data-min-subscription-qty="2"
  >

    <fieldset class="subscription-options">
      <legend class="visually-hidden">{{ 'products.product.purchase_options' | t }}</legend>

      {%- comment -%} One time (default). No price shown — the design keeps this row clean. {%- endcomment -%}
      <label class="subscription-option is-selected" data-purchase-option="onetime">
        <input type="radio" name="purchase_option" value="onetime" checked>
        <span class="subscription-box" aria-hidden="true"></span>
        <span class="subscription-option-label text-ui">{{ 'products.product.one_time' | t }}</span>
      </label>

      {%- comment -%} Subscription {%- endcomment -%}
      <label class="subscription-option" data-purchase-option="subscription">
        <input type="radio" name="purchase_option" value="subscription">
        <span class="subscription-box" aria-hidden="true"></span>
        <span class="subscription-option-label text-ui">{{ 'products.product.subscribe_save' | t: percent: discount }}</span>
        <span class="subscription-option-price text-ui">
          <s class="subscription-price-was">{{ first_alloc.compare_at_price | money }}</s>
          <span class="subscription-price-now">{{ first_alloc.price | money }}</span>
        </span>
        {%- comment -%} Hover/focus hint shown only while the option is gated (qty < min). {%- endcomment -%}
        <span class="subscription-tooltip" role="tooltip">{{ 'products.product.subscribe_min' | t: count: 2 }}</span>
      </label>
    </fieldset>

    {%- comment -%} Frequency — one option per allocation. Hidden until "Subscription" is chosen. {%- endcomment -%}
    <div class="subscription-frequency" hidden>
      <label class="visually-hidden" for="subscription-frequency-{{ product.id }}">
        {{ 'products.product.deliver_every' | t }}
      </label>
      <select
        id="subscription-frequency-{{ product.id }}"
        class="select subscription-frequency-select text-ui"
        data-subscription-frequency
      >
        {%- for allocation in variant.selling_plan_allocations -%}
          <option
            value="{{ allocation.selling_plan.id }}"
            data-price-money="{{ allocation.price | money }}"
            data-price-cents="{{ allocation.price }}"
            data-compare-cents="{{ allocation.compare_at_price }}"
          >
            {{ allocation.selling_plan.name | split: ' subscription' | first }}
          </option>
        {%- endfor -%}
      </select>
    </div>

    {%- comment -%} Read by product-form.js. Empty value = one-time purchase. {%- endcomment -%}
    <input type="hidden" name="selling_plan" value="">

  </product-subscription>
{%- endif -%}

{% stylesheet %}
  /* The whole widget is one beige panel (matches the Frood box surfaces). */
  .product-subscription {
    display: block;
    background-color: var(--color-bg-dark);
    border-radius: var(--rad-m);
    padding: var(--spacing-xxs);
  }

  .subscription-options {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  /* Rows sit directly on the panel — no per-option border/box. */
  .subscription-option {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    cursor: pointer;
  }

  /* Below the minimum subscription quantity the option is greyed out and not
     selectable (JS toggles .is-disabled and disables the radio). Greyed via
     muted colours — NOT opacity — so the tooltip child stays full-strength. */
  .subscription-option.is-disabled {
    cursor: not-allowed;
    color: var(--color-text-accent);
  }

  .subscription-option.is-disabled .subscription-option-label,
  .subscription-option.is-disabled .subscription-option-price {
    color: var(--color-text-accent);
  }

  .subscription-option.is-disabled .subscription-box {
    border-color: var(--color-text-accent);
  }

  /* Hover/focus hint that explains the gate — only visible while disabled. */
  .subscription-tooltip {
    position: absolute;
    bottom: calc(100% + var(--spacing-xxs));
    left: 0;
    z-index: 2;
    white-space: nowrap;
    padding: var(--spacing-xxs) var(--spacing-xs);
    font-size: 12px;
    line-height: 1.2;
    color: var(--color-bg);
    background-color: var(--color-text);
    border-radius: var(--rad-s);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  .subscription-tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: var(--spacing-s);
    border: 4px solid transparent;
    border-top-color: var(--color-text);
  }

  .subscription-option.is-disabled:hover .subscription-tooltip,
  .subscription-option.is-disabled:focus-within .subscription-tooltip {
    opacity: 1;
  }

  /* Hide the native radio; .subscription-box is the visible square control. */
  .subscription-option input[type="radio"] {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* Square checkbox: outlined when unselected, solid --color-text when selected. */
  .subscription-box {
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
    border: 2px solid var(--color-text);
    border-radius: var(--rad-s);
    background-color: transparent;
    transition: background-color var(--transition-fast);
  }

  .subscription-option input:checked ~ .subscription-box {
    background-color: var(--color-text);
  }

  .subscription-option input:focus-visible ~ .subscription-box {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .subscription-option-label {
    flex: 1 1 auto;
  }

  .subscription-option-price {
    white-space: nowrap;
  }

  .subscription-price-was {
    color: var(--color-text-accent);
    margin-right: var(--spacing-xxs);
  }

  /* Frequency dropdown: a distinct darker field inside the panel.
     The fill is derived from tokens (text mixed into the beige) so it reads
     a step darker than the panel without introducing a new colour. */
  .subscription-frequency {
    margin-top: var(--spacing-s);
  }

  .subscription-frequency-select {
    width: 100%;
    /* xxs all round; right keeps room for the chevron from .select */
    padding: var(--spacing-xxs) var(--spacing-m) var(--spacing-xxs) var(--spacing-xxs);
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-text) 14%, var(--color-bg-dark));
    border: 0;
    border-radius: var(--rad-s);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .subscription-box,
    .subscription-tooltip {
      transition: none;
    }
  }
{% endstylesheet %}
