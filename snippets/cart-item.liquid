{%- comment -%}
  Renders a single cart line item.

  Expects:
    - item: cart line item object

  Usage:
    {% render 'cart-item', item: item %}
{%- endcomment -%}

{%- comment -%}
  A bundle line (Build Your Box) is flagged by its hidden `_bundle` property.
  It drops the box thumbnail and shows the flavour contents (chip + name + qty)
  via `bundle-line-contents` instead of the generic property list.
{%- endcomment -%}
{%- assign is_bundle = false -%}
{%- if item.properties['_bundle'] != blank -%}
  {%- assign is_bundle = true -%}
{%- endif -%}

<div class="cart-item{% if is_bundle %} is-bundle{% endif %}" data-key="{{ item.key }}">
  {%- unless is_bundle -%}
    <a href="{{ item.url }}" class="cart-item-image">
      <div class="aspect-square">
        {{ item.image | image_url: width: 200 | image_tag:
            loading: 'lazy',
            width: item.image.width,
            height: item.image.height
        }}
      </div>
    </a>
  {%- endunless -%}

  <div class="cart-item-details">
    <a href="{{ item.url }}" class="cart-item-title">
      {{ item.product.title }}
    </a>

    {%- if item.variant.title != 'Default Title' -%}
      <p class="cart-item-variant text-mini">{{ item.variant.title }}</p>
    {%- endif -%}

    {%- if is_bundle -%}
      {% render 'bundle-line-contents', item: item %}
    {%- else -%}
      {%- comment -%}
        Generic line-item properties. Skip Shopify's hidden `_`-prefixed keys
        and any blank values — the canonical pattern.
      {%- endcomment -%}
      {%- assign has_properties = false -%}
      {%- for property in item.properties -%}
        {%- assign property_first_char = property.first | slice: 0 -%}
        {%- if property.last != blank and property_first_char != '_' -%}
          {%- assign has_properties = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_properties -%}
        <ul class="cart-item-properties text-mini unstyled-list">
          {%- for property in item.properties -%}
            {%- assign property_first_char = property.first | slice: 0 -%}
            {%- if property.last == blank or property_first_char == '_' -%}{%- continue -%}{%- endif -%}
            <li>{{ property.first }} {{ property.last }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}

    <p class="cart-item-price">
      {%- if item.original_line_price != item.final_line_price -%}
        <s class="cart-item-compare-price">{{ item.original_line_price | money }}</s>
      {%- endif -%}
      {{ item.final_line_price | money }}
    </p>

    <div class="cart-item-actions">
      <div class="cart-item-quantity">
        {% render 'quantity-selector',
          value: item.quantity,
          name: 'updates[]',
          min: 0,
          max: item.variant.inventory_quantity | default: 99,
          data_key: item.key
        %}
      </div>

      <button
        type="button"
        class="cart-item-remove button"
        data-remove="{{ item.key }}"
        aria-label="{{ 'cart.general.remove_item' | t: title: item.product.title }}"
      >
        {{ 'cart.general.remove' | t }}
      </button>
    </div>
  </div>
</div>

{% stylesheet %}
  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--spacing-base);
    padding: var(--spacing-base) 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Bundle line drops the thumbnail column — the flavour rows carry the visual. */
  .cart-item.is-bundle {
    grid-template-columns: 1fr;
  }

  .cart-item:first-child {
    padding-top: 0;
  }

  .cart-item:last-child {
    border-bottom: none;
  }

  .cart-item-image {
    display: block;
    border-radius: var(--rad-s);
    overflow: hidden;
  }

  .cart-item-details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .cart-item-title {
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cart-item-variant {
    color: var(--color-text-light);
  }

  /* Line-item properties (bundle flavours, etc.) — a quiet stacked list. */
  .cart-item-properties {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxxs);
    color: var(--color-text-light);
  }

  .cart-item-price {
    font-weight: 500;
  }

  .cart-item-compare-price {
    color: var(--color-text-light);
    margin-right: var(--spacing-xs);
  }

  .cart-item-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-s);
    margin-top: var(--spacing-xs);
  }
{% endstylesheet %}
