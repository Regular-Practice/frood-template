{% comment %}
  Renders the list of cart line items.
  Used in both cart page and cart drawer.

  Usage:
    {% render 'cart-items', cart: cart %}
{% endcomment %}

{%- comment -%}
  Custom-box lines are ordinary line items that must render as ONE block, so
  they're pulled out of the per-item loop: the first one draws the whole group
  via `custom-box-line`, the rest are skipped.
{%- endcomment -%}
<div class="cart-items">
  {%- assign box_drawn = false -%}
  {%- for item in cart.items -%}
    {%- if item.properties['_custom_box'] != blank -%}
      {%- unless box_drawn -%}
        {% render 'custom-box-line', cart: cart %}
        {%- assign box_drawn = true -%}
      {%- endunless -%}
    {%- else -%}
      {% render 'cart-item', item: item %}
    {%- endif -%}
  {%- endfor -%}
</div>
