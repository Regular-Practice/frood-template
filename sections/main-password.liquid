<div
  class="password{% if section.settings.background_video != blank or section.settings.background_image != blank %} has-background{% endif %}"
  style="--password-overlay-alpha: {{ section.settings.overlay_opacity }}%;"
>
  {%- if section.settings.background_video != blank -%}
    <video
      class="password-bg"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
      tabindex="-1"
      {%- if section.settings.background_image != blank %} poster="{{ section.settings.background_image | image_url: width: 1500 }}"{% endif -%}
    >
      {%- for source in section.settings.background_video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>
  {%- elsif section.settings.background_image != blank -%}
    {{
      section.settings.background_image
      | image_url: width: 2400
      | image_tag:
        loading: 'eager',
        widths: '375, 750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        width: section.settings.background_image.width,
        height: section.settings.background_image.height,
        class: 'password-bg',
        alt: ''
    }}
  {%- endif -%}

  <div class="password-card">
    <div class="password-panel">
      <h1 class="password-eyebrow text-h1">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'password.general.title' | t }}
        {%- endif -%}
      </h1>

      {%- assign launch_date = section.settings.launch_date | strip -%}
      {%- if launch_date != blank -%}
        {%- if section.settings.launch_message != blank -%}
          {%- assign launched_msg = section.settings.launch_message -%}
        {%- else -%}
          {%- assign launched_msg = 'password.countdown.launched' | t -%}
        {%- endif -%}
        <countdown-timer
          class="password-countdown"
          role="timer"
          data-deadline="{{ launch_date | escape }}"
          data-aria-prefix="{{ 'password.countdown.aria_prefix' | t | escape }}"
        >
          <div class="password-countdown-grid" data-grid aria-hidden="true">
            <div class="password-countdown-unit">
              <span class="password-countdown-value text-h2" data-days>00</span>
              <span class="password-countdown-label text-h1">{{ 'password.countdown.days' | t }}</span>
            </div>
            <span class="password-countdown-sep text-h2" aria-hidden="true">:</span>
            <div class="password-countdown-unit">
              <span class="password-countdown-value text-h2" data-hours>00</span>
              <span class="password-countdown-label text-h1">{{ 'password.countdown.hours' | t }}</span>
            </div>
            <span class="password-countdown-sep text-h2" aria-hidden="true">:</span>
            <div class="password-countdown-unit">
              <span class="password-countdown-value text-h2" data-minutes>00</span>
              <span class="password-countdown-label text-h1">{{ 'password.countdown.minutes' | t }}</span>
            </div>
            <span class="password-countdown-sep text-h2" aria-hidden="true">:</span>
            <div class="password-countdown-unit">
              <span class="password-countdown-value text-h2" data-seconds>00</span>
              <span class="password-countdown-label text-h1">{{ 'password.countdown.seconds' | t }}</span>
            </div>
          </div>
          <p class="password-countdown-launched text-h2" data-launched hidden>{{ launched_msg }}</p>
        </countdown-timer>
      {%- endif -%}

      <div class="password-logo">
        {% render 'logo-frood' %}
      </div>

      <p class="password-tagline text-h3">
        {%- if section.settings.subheading != blank -%}
          {{ section.settings.subheading }}
        {%- else -%}
          {{ 'password.general.newsletter_heading' | t }}
        {%- endif -%}
      </p>
    </div>

    <div class="password-form-wrapper">
      {% form 'customer', id: 'password-newsletter', class: 'password-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          {%- comment -%} Subscribed: replace the whole field with the confirmation. {%- endcomment -%}
          <p class="form-success text-body" role="alert">
            {{ 'newsletter.success' | t }}
          </p>
        {%- else -%}
          <div class="password-form-row">
            <label for="password-newsletter-email" class="visually-hidden">
              {{ 'newsletter.email_placeholder' | t }}
            </label>
            <input
              type="email"
              id="password-newsletter-email"
              name="contact[email]"
              class="password-input text-body"
              placeholder="{{ 'newsletter.email_placeholder' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="button password-submit">
              {{ 'newsletter.submit' | t }}
            </button>
          </div>

          {%- if form.errors -%}
            <div class="form-error text-body" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
    </div>
  </div>

  {%- comment -%} Quiet "staff entrance" — opens the store-password modal. {%- endcomment -%}
  <button
    type="button"
    class="password-secret-trigger"
    data-password-open
    aria-haspopup="dialog"
    aria-label="{{ 'password.general.password_label' | t }}"
  >
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
      <rect x="3" y="7" width="10" height="7" rx="1" fill="currentColor"></rect>
      <path d="M5 7V5a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </button>
</div>

{%- comment -%}
  Store-entry modal. Shopify's {% form 'storefront_password' %} POSTs to /password;
  a wrong password reloads with form.errors, so capture the form first to learn
  whether the attempt failed, then render the modal already open if it did.
{%- endcomment -%}
{%- capture password_modal_form -%}
  {% form 'storefront_password', class: 'password-modal-form' %}
    <div class="password-modal-row">
      <label for="store-password" class="visually-hidden">
        {{ 'password.general.password_label' | t }}
      </label>
      <input
        type="password"
        id="store-password"
        name="password"
        class="password-input text-body"
        placeholder="{{ 'password.general.password_placeholder' | t }}"
        autocomplete="current-password"
        required
      >
      <button type="submit" class="button">{{ 'password.general.enter' | t }}</button>
    </div>
    {%- if form.errors -%}
      {%- assign password_attempt_failed = true -%}
      <div class="form-error text-body" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}
  {% endform %}
{%- endcapture -%}

<password-modal
  class="password-modal{% if password_attempt_failed %} is-open{% endif %}"
  role="dialog"
  aria-modal="true"
  aria-hidden="{% if password_attempt_failed %}false{% else %}true{% endif %}"
  aria-label="{{ 'password.general.password_label' | t }}"
>
  <div class="password-modal-overlay" data-overlay></div>
  <div class="password-modal-panel">
    <header class="password-modal-header">
      <span class="password-modal-title text-ui">{{ 'password.general.password_label' | t }}</span>
      <button type="button" class="password-modal-close" data-close aria-label="{{ 'cart.drawer.close' | t }}">
        <span aria-hidden="true">&times;</span>
      </button>
    </header>
    <div class="password-modal-body">
      {{ password_modal_form }}
    </div>
  </div>
</password-modal>

<script type="module" src="{{ 'countdown-timer.js' | asset_url }}"></script>
<script type="module" src="{{ 'password-modal.js' | asset_url }}"></script>

{%- comment -%}
  Shopify flags a successful newsletter signup with ?customer_posted=true and
  keeps it on the URL across refreshes (which is what drives form.posted_successfully?).
  Strip it after load so the confirmation shows once, but reloading returns to the form.
{%- endcomment -%}
<script>
  (function () {
    var params = new URLSearchParams(window.location.search);
    if (!params.has('customer_posted')) return;
    params.delete('customer_posted');
    var qs = params.toString();
    window.history.replaceState(
      null,
      '',
      window.location.pathname + (qs ? '?' + qs : '') + window.location.hash
    );
  })();
</script>

{% stylesheet %}
  .password-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .password {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    padding: var(--spacing-m) var(--spacing-base);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .password-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .password.has-background::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-text) var(--password-overlay-alpha, 0%), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* Card: frosted panel + flush form row, clipped together as one rounded box */
  .password-card {
    position: relative;
    z-index: 2;
    width: min(371px, 100%);
    border-radius: var(--rad-m);
    overflow: hidden;
    color: var(--color-text);
  }

  .password-panel {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
    padding: var(--spacing-m);
    background-color: var(--color-nav);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
  }

  /* Eyebrow keeps .text-h1 typography but is dark per Figma — an explicit,
     design-approved override of the brand h1 grey. */
  .password-card .password-eyebrow {
    margin: 0;
    color: var(--color-text);
    text-align: left;
  }

  .password-logo {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-block: var(--spacing-m);
    color: var(--color-text);
  }

  .password-logo svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .password-tagline {
    margin: 0;
  }

  /* Countdown — first child of the panel, above the eyebrow. */
  .password-countdown {
    display: block;
  }

  .password-countdown-grid {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--spacing-xxs);
  }

  .password-countdown-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xxxs);
    min-width: 2.5ch;
  }

  .password-countdown-value {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  /* Unit labels keep .text-h1 typography (small uppercase) but render dark, not
     the brand grey — the same design-approved override as .password-eyebrow,
     for legibility on the frosted panel. */
  .password-countdown-label {
    color: var(--color-text);
  }

  .password-countdown-sep {
    color: var(--color-text);
    line-height: 1;
  }

  .password-countdown-launched {
    margin: 0;
    color: var(--color-text);
    text-align: center;
  }

  /* Form row: white input + yellow submit, flush; the card's clip rounds the
     bottom corners so the row needs no radius of its own. */
  .password-form-row {
    display: flex;
    align-items: stretch;
  }

  .password-input {
    flex: 1 1 auto;
    min-width: 0;
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--color-bg);
    border: none;
    border-radius: 0;
    padding: var(--spacing-xs);
    color: var(--color-text);
    /* Mixed-case input: rely on line-height for vertical centring. Text-box trim
       is now scoped to the all-caps label surfaces only (base.css §1) and kept
       off form controls, where it collapses the box model. */
    line-height: 1.4;
  }

  .password-input::placeholder {
    color: var(--color-text);
    opacity: 0.5;
  }

  .password-input:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--color-text);
  }

  .password-form .password-submit {
    border-radius: 0;
    padding: var(--spacing-xs);
    /* Optical centring comes from the .button label trim (base.css §1) — this
       element carries the .button class. */
  }

  .password-form .password-submit:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: -2px;
  }

  /* Newsletter feedback: a flush colored bar matching the toast variants
     (base.css §toast — dark text on the pale tint). No radius of its own, so the
     top butts straight against the form row and the card's clip rounds only the
     bottom corners. */
  .password-form .form-success,
  .password-form .form-error {
    display: block;
    width: 100%;
    margin: 0;
    padding: var(--spacing-xs);
    border-radius: 0;
    color: var(--color-text);
  }

  .password-form .form-success {
    background-color: var(--color-toast-success);
  }

  .password-form .form-error {
    background-color: var(--color-toast-error);
  }

  /* ---- Secret trigger: a quiet white lock in the bottom-right corner ---- */
  .password-secret-trigger {
    position: absolute;
    bottom: var(--spacing-m);
    right: var(--spacing-m);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xs);
    color: var(--color-bg);
    opacity: 0.4;
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .password-secret-trigger:hover,
  .password-secret-trigger:focus-visible {
    opacity: 1;
  }

  .password-secret-trigger svg {
    display: block;
  }

  /* ---- Store-entry modal: cart-drawer's frosted panel, centered ---- */
  body.password-modal-open {
    overflow: hidden;
  }

  .password-modal {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: grid;
    place-items: center;
    padding: var(--spacing-m);
    pointer-events: none;
  }

  .password-modal.is-open {
    pointer-events: auto;
  }

  /* Click-catcher + frosted backdrop behind the panel. */
  .password-modal-overlay {
    position: absolute;
    inset: 0;
    background: var(--color-overlay);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .password-modal.is-open .password-modal-overlay {
    opacity: 1;
  }

  /* Frosted-beige card, centered in the viewport (cf. .cart-drawer-panel). */
  .password-modal-panel {
    position: relative;
    width: min(371px, 100%);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--color-border);
    border-radius: var(--rad-s);
    background: var(--color-nav);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    transform: scale(0.96);
    opacity: 0;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .password-modal.is-open .password-modal-panel {
    transform: scale(1);
    opacity: 1;
  }

  .password-modal-header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
    padding: var(--spacing-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .password-modal-title {
    flex: 1 1 auto;
    color: var(--color-text);
  }

  .password-modal-close {
    flex: 0 0 auto;
    /* Negative margin pulls the glyph to the row edge while keeping the hit area. */
    margin: calc(var(--spacing-xxs) * -1);
    padding: var(--spacing-xxs);
    font-size: 16px;
    line-height: 1;
    color: var(--color-text-accent);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .password-modal-close:hover {
    color: var(--color-text);
  }

  .password-modal-body {
    padding: var(--spacing-m);
  }

  /* Input + submit as one rounded, clipped row (reuses .password-input). */
  .password-modal-row {
    display: flex;
    align-items: stretch;
    border-radius: var(--rad-s);
    overflow: hidden;
  }

  .password-modal-row .button {
    border-radius: 0;
    padding: var(--spacing-xs);
  }

  .password-modal-form .form-error {
    margin-top: var(--spacing-xs);
    padding: var(--spacing-xs);
    border-radius: var(--rad-s);
    background-color: var(--color-toast-error);
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .password-modal-overlay,
    .password-modal-panel {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "password-section",
  "settings": [
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Optional. Full-bleed autoplay/muted/loop behind the card. Takes precedence over the image; the image is used as its poster frame."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Full-bleed behind the card, and the poster frame when a background video is set."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "info": "Darken the background for legibility. Only applies when a background image or video is set.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Eyebrow",
      "info": "Small label above the logo. Leave blank to use default translation."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Tagline",
      "info": "Sign-up prompt below the logo. Leave blank to use default translation."
    },
    {
      "type": "header",
      "content": "Launch countdown"
    },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Launch date & time",
      "info": "ISO 8601 with timezone offset, e.g. 2026-06-01T09:00:00+01:00 (9am BST). Leave blank to hide the countdown.",
      "default": "2026-06-01T09:00:00+01:00"
    },
    {
      "type": "text",
      "id": "launch_message",
      "label": "Launched message",
      "info": "Shown when the countdown reaches zero. Leave blank to use the default translation."
    }
  ]
}
{% endschema %}
