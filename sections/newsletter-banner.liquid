{%- comment -%}
  Newsletter banner — full-bleed accent-yellow strip that sits above the footer
  (in the footer group), carrying an eyebrow + heading lockup and the newsletter
  signup pill. Inverts the default pill colours so the dark capsule reads on the
  bright accent background:
    – pill bg → --color-text     (was: --color-accent-light)
    – pill text → --color-accent (was: --color-text)
    – submit bg → --color-accent (was: --color-text)
    – submit text → --color-text (was: --color-accent-light)
  The newsletter-form snippet is reused verbatim; only colours are overridden
  via .newsletter-banner descendant selectors.
{%- endcomment -%}

<section class="newsletter-banner">
  <div class="newsletter-banner-inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="newsletter-banner-header section-lockup">
        {%- if section.settings.eyebrow != blank -%}
          <h2 class="text-h1">{{ section.settings.eyebrow }}</h2>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h3 class="text-h3">{{ section.settings.heading | newline_to_br }}</h3>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="newsletter-banner-form-group">
      {% render 'newsletter-form' %}

      <p class="newsletter-banner-consent text-body">
        {{ 'newsletter.consent_text' | t }}
        {%- if section.settings.privacy_policy != blank %} <a class="inline-link" href="{{ section.settings.privacy_policy }}">{{ 'newsletter.privacy_link_label' | t }}</a>{%- endif -%}
      </p>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Mobile + tablet (<900px): tight xs padding. Desktop+ steps up to m. */
  .newsletter-banner {
    background-color: var(--color-accent);
    color: var(--color-text);
    padding: var(--spacing-xs);
  }

  /* Phones-only: bump top/bottom for a touch more vertical breathing room. */
  @media (max-width: 599.98px) {
    .newsletter-banner {
      padding-block: var(--spacing-m);
    }
  }

  @media (min-width: 900px) {
    .newsletter-banner {
      padding: var(--spacing-m);
    }
  }

  .newsletter-banner-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-l);
    max-width: 500px;
  }

  .newsletter-banner-header h3 {
    max-width: 36ch;
  }

  /* Invert the pill on the yellow banner: dark capsule, accent-yellow text. */
  .newsletter-banner .newsletter-pill,
  .newsletter-banner .newsletter-pill:hover,
  .newsletter-banner .newsletter-pill:focus-within {
    background-color: var(--color-text);
  }

  .newsletter-banner .newsletter-input,
  .newsletter-banner .newsletter-input::placeholder {
    color: var(--color-accent);
  }

  /* Keyboard focus indicator — outline the pill in --color-bg (warm off-white)
     so it's visible against both the yellow banner AND the dark pill. Replaces
     the global outline that was suppressed earlier. */
  .newsletter-banner .newsletter-pill:focus-within {
    outline: 2px solid var(--color-bg);
    outline-offset: 2px;
  }

  /* Submit button — accent yellow with dark text. */
  .newsletter-banner .newsletter-submit {
    background-color: var(--color-accent);
    color: var(--color-text);
  }

  /* Tight stack for the form + GDPR consent line — the parent --spacing-l gap
     between the header and this group is intentional; consent sits close to the
     input it's about. */
  .newsletter-banner-form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
  }

  .newsletter-banner-consent {
    margin: 0;
    max-width: 80ch;
    /* Typographic exception — fine-print sized at 10px, smaller than the
       global .text-body 14px. Local to the consent line; doesn't change the
       token. */
    font-size: 10px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter banner",
  "tag": "section",
  "class": "newsletter-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (h1 — small uppercase label)",
      "default": "Newsletter"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (h3)",
      "info": "Press Enter to add a line break.",
      "default": "Be the first to hear about new ingredients, recipes, and limited drops."
    },
    {
      "type": "url",
      "id": "privacy_policy",
      "label": "Privacy policy URL",
      "info": "Linked from the GDPR consent line beneath the form. Pick a page (typically Privacy Policy) or paste an external URL. Leave empty to hide the link — the consent text still shows."
    }
  ],
  "presets": [
    {
      "name": "Newsletter banner"
    }
  ]
}
{% endschema %}
