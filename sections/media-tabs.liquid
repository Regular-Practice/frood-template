{%- comment -%}
  Frood Media Tabs — a static row of step cards under an optional section heading.
  Each card is a full-bleed image (or looping muted video) with a yellow step-number
  box and a white caption box sitting side by side along its bottom edge. No active
  state, no JS. The step number is derived from the block position (1, 2, 3, 4).

  Media: video OR image (merchant convention is one or the other; video wins defensively
  if both are set, matching the news-card pattern).
{%- endcomment -%}

<section class="media-tabs-section">
  {%- if section.settings.heading != blank -%}
    <h2 class="text-h3 media-tabs-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ol class="media-tabs">
    {%- for block in section.blocks -%}
      <li class="media-tab" {{ block.shopify_attributes }}>
        <div class="media-tab-bg">
          {%- if block.settings.video != blank -%}
            <video
              class="media-tab-video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-hidden="true"
            >
              {%- for source in block.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif block.settings.image != blank -%}
            {%- assign tab_alt = block.settings.image.alt | default: block.settings.description | strip_html | truncate: 100 -%}
            {{ block.settings.image | image_url: width: 900 | image_tag:
                class: 'media-tab-image',
                loading: 'lazy',
                width: block.settings.image.width,
                height: block.settings.image.height,
                alt: tab_alt
            }}
          {%- endif -%}
        </div>

        <div class="media-tab-overlay">
          <span class="text-ui media-tab-step" aria-hidden="true">{{ forloop.index }}</span>
          {%- if block.settings.description != blank -%}
            {%- comment -%}
              Wrap the first sentence in .media-tab-lead (Medium weight). Split on the first
              ". "; a single-sentence description wraps the whole first paragraph.
            {%- endcomment -%}
            {%- assign tab_desc = block.settings.description -%}
            {%- assign tab_sentences = tab_desc | split: '. ' -%}
            {%- if tab_sentences.size > 1 -%}
              {%- assign tab_rest = tab_desc | remove_first: tab_sentences.first | remove_first: '.' -%}
              {%- assign tab_lead = tab_sentences.first | replace_first: '<p>', '<p><span class="media-tab-lead">' | append: '.</span>' -%}
              {%- assign tab_desc = tab_lead | append: tab_rest -%}
            {%- else -%}
              {%- assign tab_desc = tab_desc | replace_first: '<p>', '<p><span class="media-tab-lead">' | replace_first: '</p>', '</span></p>' -%}
            {%- endif -%}
            <div class="text-body media-tab-description">{{ tab_desc }}</div>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ol>

  {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
    <div class="media-tabs-cta">
      <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .media-tabs-section {
    background-color: var(--color-bg);
    color: var(--color-text);
    padding: var(--spacing-m) var(--spacing-xs);
  }

  @media (min-width: 600px) {
    .media-tabs-section {
      padding-block: var(--spacing-l);
    }
  }

  @media (min-width: 900px) {
    .media-tabs-section {
      padding-inline: var(--spacing-m);
    }
  }

  .media-tabs-heading {
    margin: 0 0 var(--spacing-xs);
  }

  @media (min-width: 900px) {
    .media-tabs-heading {
      margin-bottom: var(--spacing-m);
    }
  }

  .media-tabs-cta {
    margin-top: var(--spacing-m);
    text-align: center;
  }

  /* Below 900px: 2x2 grid, image on top with the step chip + caption underneath.
     From 900px: four across, chip + caption overlaid on the image. */
  .media-tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-m) var(--spacing-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 900px) {
    .media-tabs {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-xxs);
    }
  }

  .media-tab {
    position: relative;
  }

  .media-tab-bg {
    position: relative;
    aspect-ratio: 51 / 40;
    overflow: hidden;
    border-radius: var(--rad-s);
    background-color: var(--color-accent-light);
  }

  @media (min-width: 900px) {
    .media-tab {
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: var(--rad-s);
    }

    .media-tab-bg {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      border-radius: 0;
    }
  }

  .media-tab-video,
  .media-tab-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Stacked under the image: small yellow chip, then the caption. */
  .media-tab-overlay {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-xxs);
    padding-top: var(--spacing-xs);
  }

  .media-tab-step {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-m);
    height: var(--spacing-m);
    padding-top: 2px;
    border-radius: var(--rad-s);
    background-color: var(--color-accent);
    color: var(--color-text);
  }

  .media-tab-description {
    min-width: 0;
    color: var(--color-text);
  }

  /* Desktop: step box + caption box side by side along the image's bottom edge.
     Stretch keeps the two the same height. */
  @media (min-width: 900px) {
    .media-tab-overlay {
      position: absolute;
      inset: auto 0 0 0;
      flex-direction: row;
      align-items: stretch;
      gap: var(--spacing-xxxs);
      padding: var(--spacing-xxs);
    }

    .media-tab-step {
      flex: none;
      width: var(--spacing-l);
      height: auto;
      min-height: var(--spacing-l);
      font-size: var(--type-h2-size);
      line-height: var(--type-h2-height);
    }

    .media-tab-description {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: var(--spacing-l);
      padding: var(--spacing-xxs);
      border-radius: var(--rad-s);
      background-color: var(--color-bg);
    }
  }

  .media-tab-description p {
    margin: 0;
  }

  /* The first sentence is wrapped in .media-tab-lead by the markup. The font only
     ships 400/500, so any manual bold maps to Medium too rather than a faked one. */
  .media-tab-lead,
  .media-tab-description strong,
  .media-tab-description b {
    font-weight: var(--type-ui-weight);
  }

  .media-tab-description p + p {
    margin-top: var(--spacing-xxs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media tabs",
  "tag": "section",
  "class": "media-tabs-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "The button shows under the cards only when both a label and a link are set."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Step",
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "info": "Shown in the white box beside the step number."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Plays muted on loop as the card background. Takes precedence over Image if both are set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Card background when no Video is set."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Media tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
