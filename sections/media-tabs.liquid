{%- comment -%}
  Frood Media Tabs — three side-by-side cards. Each card has an h2 label at the top,
  a step SVG icon centered, and a description at the bottom. The active card crossfades
  its icon out and its video in (video plays as the card background). When the video
  ends, the next card auto-activates (looping). Cards are also clickable.

  Step icons are theme assets named `step-1.svg`, `step-2.svg`, `step-3.svg` (etc.) —
  auto-derived from the block index. If you add a 4th block, drop a `step-4.svg` next
  to the others.
{%- endcomment -%}

<section class="media-tabs-section">
  <media-tabs class="media-tabs">
    {%- for block in section.blocks -%}
      <button
        type="button"
        class="media-tab{% if forloop.first %} is-active{% endif %}"
        data-tab-index="{{ forloop.index0 }}"
        aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="media-tab-bg" aria-hidden="true">
          {%- if block.settings.video != blank -%}
            <video
              class="media-tab-video"
              muted
              playsinline
              preload="metadata"
            >
              {%- for source in block.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- endif -%}
        </div>

        <div class="media-tab-content">
          {%- if block.settings.heading != blank -%}
            <h2 class="text-h2 media-tab-heading">{{ block.settings.heading }}</h2>
          {%- endif -%}

          <div class="media-tab-icon-wrap" aria-hidden="true">
            {{ 'step-' | append: forloop.index | append: '.svg' | inline_asset_content }}
          </div>

          {%- if block.settings.description != blank -%}
            <div class="text-h3 media-tab-description">{{ block.settings.description }}</div>
          {%- endif -%}
        </div>
      </button>
    {%- endfor -%}
  </media-tabs>
</section>

<script type="module" src="{{ 'media-tabs.js' | asset_url }}"></script>

{% stylesheet %}
  .media-tabs-section {
    background-color: var(--color-bg);
    color: var(--color-text);
    padding: var(--spacing-xs);
  }

  /* Phones-only: bump top/bottom for a touch more vertical breathing room. */
  @media (max-width: 599.98px) {
    .media-tabs-section {
      padding-block: var(--spacing-m);
    }
  }

  @media (min-width: 900px) {
    .media-tabs-section {
      padding: var(--spacing-m);
    }
  }

  .media-tabs {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xs);
  }

  @media (min-width: 900px) {
    .media-tabs {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-xxxs);
    }
  }

  .media-tab {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--rad-s);
    background-color: var(--color-accent-light);
    color: var(--color-text);
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  /* Active state flips the text/icon color to cream so it reads over the video.
     The step SVGs use fill="currentColor", so they follow this same color
     property — no separate icon rule needed. */
  .media-tab.is-active {
    color: var(--color-bg);
  }

  /* Video background: crossfades in on .is-active. Sits behind .media-tab-content. */
  .media-tab-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .media-tab.is-active .media-tab-bg {
    opacity: 1;
  }

  .media-tab-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Scrim over the video for legibility of the overlaid heading + description.
     Text @ 30% — stronger than the --color-overlay token's 10%. Sits inside
     .media-tab-bg so it inherits the same opacity crossfade and is invisible
     on inactive cards. */
  .media-tab-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-text) 30%, transparent);
    pointer-events: none;
  }

  /* Content sits above the video and uses flex column with the icon as a flexible
     middle spacer, so heading lands at the top and description at the bottom — the
     icon claims whatever vertical space is left. */
  .media-tab-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--spacing-xs);
  }

  .media-tab-heading {
    margin: 0;
  }

  .media-tab-icon-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Lock the SVG's currentColor to --color-text so it stays dark during the
       fade-out. Without this, .is-active flips the parent color to --color-bg
       (cream) instantly while opacity transitions out over --transition-fast,
       producing a brief "white icon" flash on the way out. */
    color: var(--color-text);
    /* Icon visible on inactive (over beige); fades out on active so the video shows */
    opacity: 1;
    transition: opacity var(--transition-fast);
  }

  .media-tab.is-active .media-tab-icon-wrap {
    opacity: 0;
  }

  /* Inlined SVG (no class — sized via parent selector). */
  .media-tab-icon-wrap > svg {
    display: block;
    width: 35%;
    max-width: 96px;
    height: auto;
  }

  .media-tab-description {
    margin: 0;
  }

  .media-tab-description p {
    margin: 0;
  }

  .media-tab-description p + p {
    margin-top: var(--spacing-xxs);
  }

  @media (prefers-reduced-motion: reduce) {
    .media-tab-bg,
    .media-tab-icon-wrap {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media tabs",
  "tag": "section",
  "class": "media-tabs-section-wrapper",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Shown as the large text at the top of the card (e.g. #1, #2, #3)."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Plays full-bleed as the card background when this tab is active. When it ends, the next tab auto-activates."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Media tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
