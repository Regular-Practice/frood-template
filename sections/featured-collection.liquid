{%- comment -%}
  Frood Featured Collection — editorial heading (eyebrow + heading + CTA) above
  either:
    • an Embla drag-and-slide carousel (enable_carousel = true), or
    • the original responsive grid (enable_carousel = false; mobile_layout
      controls mobile carousel-vs-grid).
  See CLAUDE.md → "Frood Homepage Sections" for rules.
{%- endcomment -%}

<section class="featured-collection">
  <header class="featured-collection-header section-lockup">
    {%- if section.settings.eyebrow != blank -%}
      <h1 class="text-h1">{{ section.settings.eyebrow }}</h1>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h3 class="text-h3">{{ section.settings.heading | newline_to_br }}</h3>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a
        class="button"
        href="{{ section.settings.button_link | default: '#' }}"
      >
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </header>

  {%- if section.settings.enable_carousel -%}
    <featured-collection-carousel>
      <div class="featured-collection-viewport">
        <div class="featured-collection-container">
          {%- if section.settings.collection != blank -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              <div class="featured-collection-slide">
                {% render 'product-card', product: product %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.products_to_show) -%}
              <div class="featured-collection-slide">
                <div class="placeholder-card" aria-hidden="true"></div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <button
        class="featured-collection-arrow featured-collection-arrow-prev"
        type="button"
        data-direction="prev"
        aria-label="{{ 'general.accessibility.previous_slide' | t: default: 'Previous slide' }}"
        hidden
      >
        {% render 'icon-arrow' %}
      </button>
      <button
        class="featured-collection-arrow featured-collection-arrow-next"
        type="button"
        data-direction="next"
        aria-label="{{ 'general.accessibility.next_slide' | t: default: 'Next slide' }}"
        hidden
      >
        {% render 'icon-arrow' %}
      </button>
    </featured-collection-carousel>
  {%- else -%}
    {%- if section.settings.collection != blank -%}
      <div class="featured-collection-products mobile-{{ section.settings.mobile_layout }}">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="featured-collection-products mobile-{{ section.settings.mobile_layout }}">
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="placeholder-card" aria-hidden="true"></div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{%- if section.settings.enable_carousel -%}
  <script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
  <script src="{{ 'featured-collection.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
  .featured-collection {
    padding: var(--spacing-xs);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  @media (min-width: 900px) {
    .featured-collection {
      padding: var(--spacing-m);
    }
  }

  /* Lockup alignment + internal gaps come from .section-lockup (see base.css §22).
     This rule only handles the gap between the lockup and the product area below. */
  .featured-collection-header {
    margin-bottom: var(--spacing-l);
  }

  .featured-collection-header h3 {
    max-width: 36ch;
  }

  /* ───── Carousel mode (Embla) ───── */

  /* Embla viewport — bleeds past the section's left AND right padding so cards
     reach both screen edges and give a clear drag/scroll affordance. */
  featured-collection-carousel {
    display: block;
    position: relative;
  }

  .featured-collection-viewport {
    overflow: hidden;
    margin-left: calc(-1 * var(--spacing-xs));
    margin-right: calc(-1 * var(--spacing-xs));
  }

  @media (min-width: 900px) {
    .featured-collection-viewport {
      margin-left: calc(-1 * var(--spacing-m));
      margin-right: calc(-1 * var(--spacing-m));
    }
  }

  /* Slide arrows — square accent-yellow background, dark arrow icon.
     Vertically centered, overlay the carousel. Each is hidden via the [hidden]
     attribute (toggled by JS) when there's nothing more to see that way. */
  .featured-collection-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    padding: 0;
    border: 0;
    border-radius: var(--rad-s);
    background: var(--color-accent);
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .featured-collection-arrow[hidden] {
    display: none;
  }

  .featured-collection-arrow:hover {
    background: var(--color-text);
    color: var(--color-accent);
  }

  .featured-collection-arrow-prev {
    left: var(--spacing-xs);
  }

  .featured-collection-arrow-next {
    right: var(--spacing-xs);
  }

  /* Mirror the right-arrow icon for the prev button. */
  .featured-collection-arrow-prev svg {
    transform: scaleX(-1);
  }


  .featured-collection-container {
    display: flex;
    touch-action: pan-y pinch-zoom;
  }

  featured-collection-carousel.is-initialized .featured-collection-viewport {
    cursor: grab;
  }

  featured-collection-carousel.is-initialized .featured-collection-viewport:active {
    cursor: grabbing;
  }

  .featured-collection-slide {
    flex: 0 0 75%;
    min-width: 0;
  }

  @media (min-width: 600px) {
    .featured-collection-slide {
      flex: 0 0 40%;
    }
  }

  @media (min-width: 900px) {
    .featured-collection-slide {
      flex: 0 0 calc(100% / 3);
    }
  }

  /* ───── Grid mode (original behavior) ───── */

  /* Mobile: carousel (horizontal scroll-snap).
     Bleeds past the section's right padding so cards extend to the screen edge —
     gives a clear scroll affordance. First card aligns with the left padding. */
  .featured-collection-products.mobile-carousel {
    display: flex;
    gap: var(--spacing-xs);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--spacing-xs);
    margin-right: calc(-1 * var(--spacing-xs));
  }

  .featured-collection-products.mobile-carousel::-webkit-scrollbar {
    display: none;
  }

  .featured-collection-products.mobile-carousel > * {
    flex: 0 0 75%;
    scroll-snap-align: start;
  }

  /* Mobile: stacked grid (1 column) */
  .featured-collection-products.mobile-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xs);
  }

  /* Tablet+: 2-column grid (overrides both mobile modes).
     Also resets the carousel's right-edge bleed and flex item sizing. */
  @media (min-width: 600px) {
    .featured-collection-products.mobile-carousel,
    .featured-collection-products.mobile-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-xs);
      overflow: visible;
      padding-bottom: 0;
      margin-right: 0;
    }

    .featured-collection-products.mobile-carousel > * {
      flex: initial;
      scroll-snap-align: none;
    }
  }

  /* Desktop+: 4-column grid */
  @media (min-width: 900px) {
    .featured-collection-products.mobile-carousel,
    .featured-collection-products.mobile-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ───── Shared ───── */

  /* Placeholder card (when no collection is selected) */
  .placeholder-card {
    aspect-ratio: 3 / 4;
    background: var(--color-border);
    border-radius: var(--rad-s);
    animation: placeholder-pulse 1.5s ease-in-out infinite;
  }

  @keyframes placeholder-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .placeholder-card {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (h1 — small uppercase label)",
      "default": "Our collection"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (h3)",
      "info": "Press Enter to add a line break.",
      "default": "Real food, made simple.\nMade for modern home cooks."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Our range"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Carousel (drag-and-slide)",
      "info": "When off, products show in the responsive grid below.",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout (grid mode only)",
      "info": "Used only when carousel is off. Tablet and desktop are always a grid.",
      "options": [
        { "value": "carousel", "label": "Carousel (horizontal scroll)" },
        { "value": "grid", "label": "Grid (stacked)" }
      ],
      "default": "carousel"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
