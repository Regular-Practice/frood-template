<section class="main-product color-{{ section.settings.color_scheme }}">
  {% render 'json-ld-product', product: product %}

  {%- comment -%}
    Background slider: product.media from index 2 onwards (the first two
    media entries are reserved — media[0] is rendered inside Box 1 as the
    product render; media[1] is currently unused but kept reserved per spec).
  {%- endcomment -%}
  {%- if product.media.size > 2 -%}
    <product-bg-slider class="product-bg-slider" aria-hidden="true">
      <div class="product-bg-slider-viewport">
        <div class="product-bg-slider-container">
          {%- for media in product.media offset: 2 -%}
            <div class="product-bg-slider-slide">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{ media | image_url: width: 2400 | image_tag:
                    loading: 'lazy',
                    alt: '',
                    width: media.width,
                    height: media.height
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
                {%- when 'external_video' -%}
                  {%- if media.host == 'youtube' -%}
                    <iframe
                      src="https://www.youtube.com/embed/{{ media.external_id }}?autoplay=1&mute=1&loop=1&controls=0&playlist={{ media.external_id }}"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"
                      title=""
                    ></iframe>
                  {%- elsif media.host == 'vimeo' -%}
                    <iframe
                      src="https://player.vimeo.com/video/{{ media.external_id }}?autoplay=1&muted=1&loop=1&controls=0"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"
                      title=""
                    ></iframe>
                  {%- endif -%}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </product-bg-slider>
  {%- endif -%}

  <product-form
    class="product-boxes"
    data-section-id="{{ section.id }}"
    data-added-message="{{ 'products.product.added_to_cart' | t: product: product.title }}"
  >
    <script type="application/json" class="product-json">
      {{ product | json }}
    </script>

    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      {%- comment -%} Box 1: eyebrow + title + product render. Each content
                       section (Details / Instructions / Nutritional info) is
                       its own card below — separate boxes, not hairlines. {%- endcomment -%}
      <div class="product-box product-box-main">
        <header class="section-lockup">
          <p class="text-h1">4 PACK</p>
          <h1 class="text-h2 product-box-title">{{ product.title }}</h1>
        </header>

        {%- comment -%}
          Box render: prefer `custom.product_render_video` (hand-rendered 3D loop)
          over product.media[0]. Falls back so unauthored products still display.
        {%- endcomment -%}
        {%- assign render_video = product.metafields.custom.product_render_video.value -%}
        {%- assign primary_media = product.media[0] -%}
        {%- if render_video != blank or primary_media -%}
          <div class="product-box-render">
            {%- if render_video != blank -%}
              {%- comment -%}
                File-reference metafield pointing to a video file — .value is a
                media_video drop. video_tag renders the <video> with all the
                derived sources (mp4 / webm). Plays once on load (autoplay) and
                re-plays from 0 whenever it scrolls back into view, via the
                wrapping <product-render-video> custom element.
              {%- endcomment -%}
              <product-render-video class="product-render-video">
                {{ render_video | video_tag: autoplay: true, muted: true, controls: false, playsinline: true }}
              </product-render-video>
            {%- else -%}
              {%- case primary_media.media_type -%}
                {%- when 'image' -%}
                  {{ primary_media | image_url: width: 1200 | image_tag:
                    loading: 'eager',
                    alt: primary_media.alt | default: product.title,
                    width: primary_media.width,
                    height: primary_media.height
                  }}
                {%- when 'video' -%}
                  {{ primary_media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
                {%- when 'external_video' -%}
                  {%- if primary_media.host == 'youtube' -%}
                    <iframe
                      src="https://www.youtube.com/embed/{{ primary_media.external_id }}?autoplay=1&mute=1&loop=1&controls=0&playlist={{ primary_media.external_id }}"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"
                      title="{{ product.title }}"
                    ></iframe>
                  {%- elsif primary_media.host == 'vimeo' -%}
                    <iframe
                      src="https://player.vimeo.com/video/{{ primary_media.external_id }}?autoplay=1&muted=1&loop=1&controls=0"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"
                      title="{{ product.title }}"
                    ></iframe>
                  {%- endif -%}
                {%- when 'model' -%}
                  {{ primary_media | model_viewer_tag }}
              {%- endcase -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Details box: product description (open by default) {%- endcomment -%}
      {%- if product.description != blank -%}
        <details class="product-box product-accordion" open>
          <summary>
            <span class="text-ui">{{ 'products.product.details' | t }}</span>
            <span class="product-accordion-icon" aria-hidden="true">
            <svg class="icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M5.14286 6.85714H0V5.14286H5.14286V0H6.85714V5.14286H12V6.85714H6.85714V12H5.14286V6.85714Z" fill="currentColor"/>
            </svg>
            <svg class="icon-minus" width="12" height="2" viewBox="0 0 12 2" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M0 1.75V0H12V1.75H0Z" fill="currentColor"/>
            </svg>
          </span>
          </summary>
          <div class="product-accordion-content typeset">
            {{ product.description }}
          </div>
        </details>
      {%- endif -%}

      {%- comment -%} Instructions box (metafield) {%- endcomment -%}
      {%- if product.metafields.custom.instructions != blank -%}
        <details class="product-box product-accordion">
          <summary>
            <span class="text-ui">{{ 'products.product.instructions' | t }}</span>
            <span class="product-accordion-icon" aria-hidden="true">
            <svg class="icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M5.14286 6.85714H0V5.14286H5.14286V0H6.85714V5.14286H12V6.85714H6.85714V12H5.14286V6.85714Z" fill="currentColor"/>
            </svg>
            <svg class="icon-minus" width="12" height="2" viewBox="0 0 12 2" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M0 1.75V0H12V1.75H0Z" fill="currentColor"/>
            </svg>
          </span>
          </summary>
          <div class="product-accordion-content typeset">
            {{ product.metafields.custom.instructions | metafield_tag }}
          </div>
        </details>
      {%- endif -%}

      {%- comment -%} Nutritional info box (metafield) {%- endcomment -%}
      {%- if product.metafields.custom.nutritional_info != blank -%}
        <details class="product-box product-accordion">
          <summary>
            <span class="text-ui">{{ 'products.product.nutritional_info' | t }}</span>
            <span class="product-accordion-icon" aria-hidden="true">
            <svg class="icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M5.14286 6.85714H0V5.14286H5.14286V0H6.85714V5.14286H12V6.85714H6.85714V12H5.14286V6.85714Z" fill="currentColor"/>
            </svg>
            <svg class="icon-minus" width="12" height="2" viewBox="0 0 12 2" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M0 1.75V0H12V1.75H0Z" fill="currentColor"/>
            </svg>
          </span>
          </summary>
          <div class="product-accordion-content typeset">
            {{ product.metafields.custom.nutritional_info | metafield_tag }}
          </div>
        </details>
      {%- endif -%}

      {%- comment -%} Variants (own box, only when the product has real variant options) {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        <div class="product-box product-box-variants">
          {% render 'product-variant-selector', product: product %}
        </div>
      {%- endunless -%}

      {%- comment -%}
        Buy row: bare Qty selector (left) + Add to cart button (right) —
        no .product-box wrapper, so each element shows its own surface
        (warm-beige qty slab, yellow button) directly on the bg slider.
      {%- endcomment -%}
      <div class="product-buy-row">
        <div class="product-buy-qty">
          {% render 'quantity-selector' %}
        </div>

        <div class="product-buy-add" data-variant-render="buy-buttons">
          {% render 'product-buy-buttons', product: product, show_quantity: false %}
        </div>
      </div>
    {%- endform -%}
  </product-form>
</section>

<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
<script src="{{ 'product-bg-slider.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-selector.js' | asset_url }}" defer></script>
<script src="{{ 'product-render-video.js' | asset_url }}" defer></script>
<script src="{{ 'product-boxes-scroll.js' | asset_url }}" defer></script>

{% stylesheet %}
  .main-product {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    padding: var(--spacing-m);
  }

  @media (max-width: 899px) {
    .main-product {
      padding: var(--spacing-xs);
    }
  }


  /* Scheme-1 PDP runs tighter so the boxes column reads as a floating panel
     rather than a section with broad chrome. */
  .main-product.color-scheme-1 {
    padding: var(--spacing-xxs);
  }

  /* Background slider — fills section, sits behind boxes */
  .product-bg-slider {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    overflow: hidden;
  }

  .product-bg-slider-viewport {
    height: 100%;
    overflow: hidden;
  }

  .product-bg-slider-container {
    display: flex;
    height: 100%;
  }

  /* Each slide shrinks to fit its image so multiple slides can sit side-by-side
     in the flex row — neighbours peek at the edges of the viewport. */
  .product-bg-slider-slide {
    flex: 0 0 auto;
    min-width: 0;
    height: 100%;
  }

  /* Images / videos: fill container height, width auto so the intrinsic aspect
     ratio is preserved (object-fit is irrelevant when the box matches the
     media's natural ratio). */
  .product-bg-slider-slide img,
  .product-bg-slider-slide video,
  .product-bg-slider-slide model-viewer {
    width: auto;
    height: 100%;
    display: block;
  }

  /* iframes (YouTube/Vimeo) have no intrinsic ratio — give them a 16:9 box. */
  .product-bg-slider-slide iframe {
    height: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    display: block;
  }

  /* Boxes column — left-aligned, sits on top of slider. The actual flex
     stack (gap between .product-box children) lives on the inner <form> below,
     since <product-form>'s direct children are <script> + <form>, not the
     boxes themselves. Applying the gap here would just gap script/form. */
  /* Boxes column — left-aligned, sits on top of slider. Caps at 386px wide.
     At ≥900px the header's bento nav (400px wide) is centered in the viewport;
     once the viewport narrows enough that the boxes' right edge would cross
     into the bento (with less than --spacing-m of clearance), the `min()`
     clamp shrinks the column so its right edge keeps M away from the bento's
     left edge. Bento's left edge = (100vw - 400px) / 2; subtracting section's
     left padding (--spacing-m) + the M gap gives the max allowable width. */
  /* Always fixed at top-left with xxs offsets so the column doesn't scroll
     away while the user is on the section. Compact form (toggled by
     product-boxes-scroll.js) just hides the render/accordions/variants. */
  .product-boxes {
    position: fixed;
    top: var(--spacing-xxs);
    left: var(--spacing-xxs);
    right: var(--spacing-xxs);
    z-index: 50;
    display: block;
    width: auto;
    max-width: 386px;
  }

  @media (min-width: 900px) {
    .product-boxes {
      max-width: min(386px, calc((100vw - 400px) / 2 - var(--spacing-m) - var(--spacing-m)));
    }
  }

  /* Animated full↔compact transition. Each element that disappears in compact
     collapses its max-height + padding + margin and fades out, so the column
     visibly shrinks rather than snapping. */
  .product-box-render,
  .product-boxes .product-accordion,
  .product-boxes .product-box-variants {
    max-height: 1200px;
    overflow: hidden;
    opacity: 1;
    transition:
      max-height 0.35s ease,
      opacity 0.2s ease 0.05s,
      margin-top 0.3s ease,
      margin-bottom 0.3s ease,
      padding-block 0.3s ease;
  }

  .product-boxes.is-compact .product-box-render {
    max-height: 0;
    opacity: 0;
    margin-block: 0;
    padding-block: 0;
    pointer-events: none;
  }

  /* Accordions + variants are direct children of <form> and inherit its
     xxxs flex gap. With max-height: 0 each one collapses to 0 height but
     the flex gap above it is still painted — multiple collapsed siblings
     stack those gaps. Negative margin-top of -xxxs cancels each preceding
     flex gap, so the only surviving gap is the one before the (visible)
     buy row: exactly one xxxs between Box 1 and the buy row. */
  .product-boxes.is-compact .product-accordion,
  .product-boxes.is-compact .product-box-variants {
    max-height: 0;
    opacity: 0;
    margin-top: calc(-1 * var(--spacing-xxxs));
    margin-bottom: 0;
    padding-block: 0;
    pointer-events: none;
  }

  /* Kill the .product-box-main flex gap above the (now-collapsed) render so
     the header sits flush with the next visible element. */
  .product-boxes.is-compact .product-box-main {
    gap: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-box-render,
    .product-boxes .product-accordion,
    .product-boxes .product-box-variants {
      transition: none;
    }
  }

  /* The {% form 'product' %} tag renders a <form> that holds the actual
     .product-box children. This is where the gap needs to apply. */
  .product-boxes form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxxs);
  }

  /* Shared box treatment — warm beige bg, xxs inset, brand radius. */
  .product-box {
    background: var(--color-bg-dark);
    color: var(--color-text);
    border-radius: var(--rad-s);
    padding: var(--spacing-xxs);
  }

  /* Box 1: main content stack. The eyebrow + title pair is wrapped in a
     .section-lockup which bakes in the canonical xxs gap between them. The
     lockup already sets margin: 0 on children and margin-top: xxs between
     siblings, so no per-element overrides needed here. */
  .product-box-main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
  }

  .product-box-render {
    width: 65%;
    margin-inline: auto;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--rad-s);
    background: var(--color-bg-dark);
  }

  .product-box-render img,
  .product-box-render video,
  .product-box-render iframe,
  .product-box-render model-viewer {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 0;
  }

  /* Buy row: bare qty stepper + button, no .product-box wrapper.

     LAYOUT — CSS Grid, two columns:
       auto  → qty stepper column (.product-buy-qty, source order 1, left)
       1fr   → add-to-cart button column (.product-buy-add, source order 2, right)
     Grid is used (not flex) because flex was letting the qty stepper's
     intrinsic content push it past the row's right edge — `auto` in Grid is
     a hard "size to content, no more" constraint, and `1fr` only takes the
     remaining space. Column placement follows source order (no grid-column
     overrides) — qty sits left because it's the first child in the markup.

     WIDTH — fills the full .product-boxes column (max-width 386px in this
     theme). The row is a flex item of the form's column flex (default
     align-items: stretch), but width: 100% is set explicitly so the
     relationship to the boxes above is obvious in the code.

     HEIGHT — matches a closed .product-accordion: .product-box xxs padding × 2
     plus one rendered line of the summary's .text-ui label (font-size × 1.2em
     line-height). align-items: stretch fills the two grid cells, and the
     inner button + qty surfaces fill their cells, so both read as the same
     height as the dropdown summaries above. */
  .product-buy-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    gap: var(--spacing-xxxs);
    width: 100%;
    min-height: calc(var(--spacing-xxs) * 2 + var(--type-ui-size) * 1.2);
  }

  /* Add-to-cart cell. .product-buy-add is a flex container so the existing
     .buy-buttons → .button chain fills both axes (flex: 1 + stretch). */
  .product-buy-add {
    min-width: 0;
    display: flex;
  }

  /* Add-to-cart label overrides for this PDP context only:
     – text-align left (vs default .button center)
     – typography switches from .text-h1 base (uppercase 12px) to .text-ui
       (14px / 1.2em / 0 letter-spacing / no transform). Weight stays 500
       (same as default .button), so only size/height/spacing/case change. */
  .product-buy-add .button {
    text-align: left;
    font-size: var(--type-ui-size);
    line-height: var(--type-ui-height);
    letter-spacing: var(--type-ui-spacing);
    text-transform: none;
  }

  .product-buy-add .buy-buttons {
    flex: 1;
    min-width: 0;
  }

  /* Qty cell. The snippet renders:
       .product-buy-qty > <quantity-selector> > .quantity-selector (visible slab)
     <quantity-selector> is inline-block by default and .quantity-selector is
     inline-flex — neither stretches to fill the grid cell's height on its
     own. Make each layer a flex container with explicit `align-self: stretch`
     so cross-axis stretch flows all the way down to the visible slab and
     matches the add-to-cart button height. */
  .product-buy-qty {
    display: flex;
    align-items: stretch;
  }

  .product-buy-qty quantity-selector {
    display: flex;
    flex: 1;
    align-self: stretch;
  }

  .product-buy-qty .quantity-selector {
    flex: 1;
    align-self: stretch;
  }

  .product-variants {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .variant-options {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .buy-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-s);
    align-items: stretch;
  }

  .buy-buttons .button {
    flex: 1;
  }

  /* Accordion boxes (Details / Instructions / Nutritional info) — each is its
     own .product-box card; the .product-box's xxs padding wraps the summary +
     (when open) content. */
  .product-accordion summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .product-accordion summary::-webkit-details-marker {
    display: none;
  }

  /* Accordion icon: plus by default, swaps to minus when [open]. Both SVGs
     inline so `currentColor` inherits from the summary; sized to 1em so
     they match the .text-ui label sitting next to them. */
  .product-accordion-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
  }

  .product-accordion-icon svg {
    width: 0.8em;
    height: auto;
    display: block;
  }

  .product-accordion-icon .icon-minus {
    display: none;
  }

  .product-accordion[open] .product-accordion-icon .icon-plus {
    display: none;
  }

  .product-accordion[open] .product-accordion-icon .icon-minus {
    display: block;
  }

  .product-accordion-content {
    padding-top: var(--spacing-xxs);
  }

  product-form.is-loading [data-variant-render] {
    opacity: 0.6;
    pointer-events: none;
  }

  /* Tablet (600–899px): boxes column anchors to the bottom-left corner of
     the bg slider area (was sticky top-left on desktop). Box 1 lays its
     section-lockup (eyebrow + title) and the render side-by-side instead
     of stacked, since the column is shorter when bottom-anchored. */
  @media (min-width: 600px) and (max-width: 899px) {
    .product-boxes {
      position: absolute;
      inset: auto auto var(--spacing-xs) var(--spacing-xs);
      top: auto;
    }

    /* row-reverse so the render visually leads (left) and the section-lockup
       sits to the right of it, without touching the source order. */
    .product-box-main {
      flex-direction: row-reverse;
      align-items: center;
      gap: var(--spacing-xs);
    }

    .product-box-main .section-lockup {
      flex: 1;
      min-width: 0;
    }

    .product-box-render {
      width: 28%;
      flex-shrink: 0;
      margin-inline: 0;
    }
  }

  /* Mobile only (<600px): break the desktop/tablet overlay layout — the bg
     slider and boxes column stack vertically in normal block flow instead of
     the slider sitting behind a fixed/floating boxes column.

     This block MUST come after the .product-boxes base rule (which sets
     position: fixed + max-width: 386px) so the cascade lets these overrides
     win at mobile widths. Tablet keeps its own overlay arrangement in the
     600–899px block directly above. */
  @media (max-width: 599px) {
    .main-product {
      /* Section is content-sized once children are in normal flow; the
         100svh min-height was only there to give the absolute-positioned
         slider something to fill. */
      min-height: 0;
    }

    /* Slider sits in-flow at the top of the section. 1:1 aspect ratio so it
       reads as a hero image rather than a thin strip. */
    .product-bg-slider {
      position: static;
      width: 100%;
      aspect-ratio: 1 / 1;
    }

    /* Boxes flow below the slider, full section width — drops the 386px cap,
       the fixed positioning, and the .is-compact pinning used on desktop.
       margin-top opens the gap between slider and boxes; matches the mobile
       section padding (--spacing-xs) so the slider→boxes gap reads the same
       as the section's edge inset. */
    .product-boxes,
    .product-boxes.is-compact {
      position: static;
      width: 100%;
      max-width: none;
      top: auto;
      left: auto;
      right: auto;
      margin-top: var(--spacing-xs);
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
