{%- capture accordion_icon -%}
  <span class="product-accordion-icon" aria-hidden="true">
    <svg class="icon-plus" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <path d="M5.14286 6.85714H0V5.14286H5.14286V0H6.85714V5.14286H12V6.85714H6.85714V12H5.14286V6.85714Z" fill="currentColor"/>
    </svg>
    <svg class="icon-minus" width="12" height="2" viewBox="0 0 12 2" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <path d="M0 1.75V0H12V1.75H0Z" fill="currentColor"/>
    </svg>
  </span>
{%- endcapture -%}

<section class="main-product">
  {% render 'json-ld-product', product: product %}

  <product-form
    class="product-boxes"
    data-section-id="{{ section.id }}"
    data-added-message="{{ 'products.product.added_to_cart' | t: product: product.title }}"
  >
    <script type="application/json" class="product-json">
      {{ product | json }}
    </script>

    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      {%- comment -%}
        Two-column PDP: this left column (eyebrow, title, blurb, purchase
        options, buy row, then hairline accordions pinned to the bottom) sits
        beside the image slider. No cards — everything sits on the page bg.
      {%- endcomment -%}
      <header class="section-lockup product-header">
        {%- comment -%}
          Pack-size eyebrow. Per-product via the `custom.pack_size` choice-list
          metafield ("4 Pack" / "6 Pack"); upcased here so the stored value stays
          readable in admin while the PDP follows the all-caps h1 convention.
          Omitted entirely when the metafield is unset.
        {%- endcomment -%}
        {%- assign pack_size = product.metafields.custom.pack_size.value -%}
        {%- if pack_size != blank -%}
          <p class="text-h1">{{ pack_size | upcase }}</p>
        {%- endif -%}
        <h1 class="text-h3 product-title">{{ product.title }}</h1>
      </header>

      {%- comment -%}
        Blurb: the first ~40 words of the description, as plain text. There is
        no separate "Details" accordion any more, so a description longer than
        the blurb is only shown truncated here.
      {%- endcomment -%}
      {%- assign description_text = product.description | strip_html | strip -%}
      {%- assign blurb = description_text | truncatewords: 40 -%}
      {%- if description_text != blank -%}
        <p class="text-body product-blurb">{{ blurb }}</p>
      {%- endif -%}

      <div class="product-purchase">
        {%- unless product.has_only_default_variant -%}
          <div class="product-variants-wrap">
            {% render 'product-variant-selector', product: product %}
          </div>
        {%- endunless -%}

        {%- comment -%}
          Subscription selector: native Frood-styled one-time / subscribe picker.
          Renders only when the product has Recharge selling plans; writes the
          chosen selling_plan into a hidden input read by product-form.js.
        {%- endcomment -%}
        {% render 'product-subscription', product: product, info_link: section.settings.subscription_info_link %}

        {%- comment -%}
          Buy row: bare qty selector (left) + Add to cart button (right), each
          showing its own surface (warm-beige slab, yellow button).
        {%- endcomment -%}
        <div class="product-buy-row">
          <div class="product-buy-qty">
            {% render 'quantity-selector' %}
          </div>

          <div class="product-buy-add" data-variant-render="buy-buttons">
            {% render 'product-buy-buttons', product: product, show_quantity: false %}
          </div>
        </div>
      </div>

      <accordion-list class="product-accordions">
        {%- comment -%} How to Frood (instructions metafield) {%- endcomment -%}
        {%- if product.metafields.custom.instructions != blank -%}
          <details class="product-accordion">
            <summary>
              <span class="text-ui">{{ 'products.product.instructions' | t }}</span>
              {{ accordion_icon }}
            </summary>
            <div class="accordion-content">
              <div class="accordion-content-inner">
                <div class="product-accordion-content typeset">
                  {{ product.metafields.custom.instructions | metafield_tag }}
                </div>
              </div>
            </div>
          </details>
        {%- endif -%}

        {%- comment -%}
          Nutrition: the merchant's `custom.nutritional_info` richtext, plus a
          "View full nutrition" link opening the per-flavour tables in an
          overlay. The tables live in the dialog rather than inline so the
          accordion stays short — the mixed box stacks four of them.

          Captured rather than tested via a metafield: whether there's a dialog
          to offer depends on the flavours' own nutrition fields, and
          nutrition-modal already owns that logic — re-deriving it here would be
          two copies to keep in step. Section styles are hoisted at compile
          time, so the capture holds markup only. The row shows if either half
          has something.
        {%- endcomment -%}
        {%- capture nutrition_modal -%}{% render 'nutrition-modal', product: product %}{%- endcapture -%}
        {%- assign nutrition_modal = nutrition_modal | strip -%}
        {%- if nutrition_modal != blank or product.metafields.custom.nutritional_info != blank -%}
          <details class="product-accordion">
            <summary>
              <span class="text-ui">{{ 'products.product.nutritional_info' | t }}</span>
              {{ accordion_icon }}
            </summary>
            <div class="accordion-content">
              <div class="accordion-content-inner">
                <div class="product-accordion-content product-nutrition-body">
                  {%- if product.metafields.custom.nutritional_info != blank -%}
                    <div class="typeset">
                      {{ product.metafields.custom.nutritional_info | metafield_tag }}
                    </div>
                  {%- endif -%}
                  {{ nutrition_modal }}
                </div>
              </div>
            </div>
          </details>
        {%- endif -%}

        {%- comment -%}
          Benefits / Who is it for / How does the subscription work: one rich
          text metafield each (custom.benefits, custom.who_is_it_for,
          custom.how_does_the_subscription_work). Each row only renders when
          its metafield has content. Order: Instructions, Nutritional info,
          Benefits, Who is it for, How does the subscription work.
        {%- endcomment -%}
        {%- if product.metafields.custom.benefits != blank -%}
          <details class="product-accordion">
            <summary>
              <span class="text-ui">{{ 'products.product.benefits' | t }}</span>
              {{ accordion_icon }}
            </summary>
            <div class="accordion-content">
              <div class="accordion-content-inner">
                <div class="product-accordion-content typeset">
                  {{ product.metafields.custom.benefits | metafield_tag }}
                </div>
              </div>
            </div>
          </details>
        {%- endif -%}

        {%- if product.metafields.custom.who_is_it_for != blank -%}
          <details class="product-accordion">
            <summary>
              <span class="text-ui">{{ 'products.product.who_is_it_for' | t }}</span>
              {{ accordion_icon }}
            </summary>
            <div class="accordion-content">
              <div class="accordion-content-inner">
                <div class="product-accordion-content typeset">
                  {{ product.metafields.custom.who_is_it_for | metafield_tag }}
                </div>
              </div>
            </div>
          </details>
        {%- endif -%}

        {%- if product.metafields.custom.how_does_the_subscription_work != blank -%}
          <details class="product-accordion">
            <summary>
              <span class="text-ui">{{ 'products.product.subscription_how' | t }}</span>
              {{ accordion_icon }}
            </summary>
            <div class="accordion-content">
              <div class="accordion-content-inner">
                <div class="product-accordion-content typeset">
                  {{ product.metafields.custom.how_does_the_subscription_work | metafield_tag }}
                </div>
              </div>
            </div>
          </details>
        {%- endif -%}
      </accordion-list>
    {%- endform -%}
  </product-form>

  {%- comment -%}
    Gallery sequence: the product's own media (minus media[0], the box render /
    pack shot) interleaved with the `custom.info_image` metafield, starting with a
    product image: product 1, info 1, product 2, info 2 … whichever list is
    longer just carries on alone at the end. With no info images the gallery is
    the product media as-is.

    Each item is captured once and output in two containers, only one of which
    is visible at a time:
      - <900px: a square Embla slider with prev/next pills.
      - ≥900px: one column of squares; the text column beside it is sticky,
        so the images scroll past it until the section ends.
  {%- endcomment -%}
  {%- assign gallery_media = product.media | slice: 1, 100 -%}
  {%- assign info_images = product.metafields.custom.info_image.value | default: product.metafields.custom.image.value -%}
  {%- comment -%} Works whether the metafield is a single file or a list of files. {%- endcomment -%}
  {%- if info_images.media_type != blank -%}
    {%- assign info_single = true -%}
    {%- assign info_count = 1 -%}
  {%- else -%}
    {%- assign info_single = false -%}
    {%- assign info_count = info_images.size | default: 0 -%}
  {%- endif -%}
  {%- assign gallery_count = gallery_media.size -%}
  {%- if info_count > gallery_count -%}
    {%- assign gallery_count = info_count -%}
  {%- endif -%}
  {%- if gallery_count > 0 -%}
    {%- capture media_items -%}
      {%- for i in (1..gallery_count) -%}
        {%- assign index = i | minus: 1 -%}
        {%- if gallery_media[index] -%}
          {% render 'product-media-item', media: gallery_media[index], product: product %}
        {%- endif -%}
        {%- comment -%} The metafield list can be looped but not indexed, so pick item N by iterating. {%- endcomment -%}
        {%- if info_single -%}
          {%- if index == 0 -%}
            {% render 'product-media-item', media: info_images, product: product %}
          {%- endif -%}
        {%- else -%}
          {%- for info_image in info_images -%}
            {%- if forloop.index0 == index -%}
              {% render 'product-media-item', media: info_image, product: product %}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    <product-bg-slider class="product-bg-slider">
      <div class="product-bg-slider-viewport">
        <div class="product-bg-slider-container">
          {{ media_items }}
        </div>
      </div>
      <div class="product-bg-slider-nav">
        <button type="button" class="product-bg-slider-btn product-bg-slider-prev" aria-label="Previous slide">
          {% render 'icon-arrow' %}
        </button>
        <button type="button" class="product-bg-slider-btn product-bg-slider-next" aria-label="Next slide">
          {% render 'icon-arrow' %}
        </button>
      </div>
    </product-bg-slider>

    <div class="product-images">
      {{ media_items }}
    </div>
  {%- endif -%}
</section>

<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script src="{{ 'product-subscription.js' | asset_url }}" defer></script>
<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
<script src="{{ 'product-bg-slider.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-selector.js' | asset_url }}" defer></script>
<script type="module" src="{{ 'accordion.js' | asset_url }}"></script>

{% stylesheet %}
  /* Two-column PDP. Mobile/tablet: details on top, slider below in normal
     flow. Desktop (≥900px): details column left, slider right, both filling
     the viewport height. Everything sits on the page bg — no cards. */
  .main-product {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-xs);
  }

  .product-boxes {
    display: block;
    min-width: 0;
  }

  /* The {% form 'product' %} tag renders the <form> holding the column. */
  .product-boxes form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-m);
    height: 100%;
  }

  .product-header .product-title {
    margin: 0;
  }

  .product-blurb {
    margin: 0;
    max-width: 60ch;
  }

  .product-purchase {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  /* Accordions sit at the bottom of the column on desktop; on smaller screens
     they just follow the buy row. */
  .product-accordions {
    display: block;
    margin-top: var(--spacing-m);
  }

  /* Mobile/tablet: a square slider leads, clearing the fixed header, and the
     text column follows below it. (Visual order only — the DOM keeps the text
     first.) The stacked column is desktop-only. */
  .product-bg-slider {
    order: -1;
    position: relative;
    display: block;
    overflow: hidden;
    margin-top: var(--header-height);
    margin-bottom: var(--spacing-m);
    aspect-ratio: 1 / 1;
    border-radius: var(--rad-s);
  }

  .product-bg-slider-viewport {
    height: 100%;
    overflow: hidden;
  }

  .product-bg-slider-container {
    display: flex;
    height: 100%;
  }

  /* One slide per view. */
  .product-bg-slider .product-media-item {
    flex: 0 0 100%;
    min-width: 0;
    height: 100%;
  }

  .product-bg-slider .product-media-item img,
  .product-bg-slider .product-media-item video,
  .product-bg-slider .product-media-item model-viewer,
  .product-bg-slider .product-media-item iframe {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  /* Slider nav — prev/next pills anchored bottom-right. Styling mirrors
     .recipe-control-pill (snippets/video.liquid): beige bg, dark burgundy
     icon, pale-yellow on hover, --rad-s rounded. Hidden until embla
     initialises so single-slide products don't show dead controls. */
  .product-bg-slider-nav {
    position: absolute;
    bottom: var(--spacing-xs);
    right: var(--spacing-xs);
    z-index: 2;
    display: none;
    gap: var(--spacing-xxs);
  }

  .product-bg-slider.is-initialized .product-bg-slider-nav {
    display: flex;
  }

  .product-bg-slider-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xxs);
    background-color: var(--color-bg-dark);
    color: var(--color-text);
    border: 0;
    border-radius: var(--rad-s);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .product-bg-slider-btn:hover {
    background-color: var(--color-accent-light);
  }

  .product-bg-slider-btn svg {
    display: block;
  }

  /* icon-arrow points right by default; flip 180° for the prev button. */
  .product-bg-slider-prev svg {
    transform: rotate(180deg);
  }

  .product-images {
    display: none;
  }

  @media (min-width: 900px) {
    .main-product {
      display: grid;
      /* Same clamp as before: the header's bento nav (400px, centred) must
         keep --spacing-m clear of this column's right edge. */
      grid-template-columns: min(386px, calc((100vw - 400px) / 2 - var(--spacing-m) - var(--spacing-m))) 1fr;
      gap: var(--spacing-l);
      min-height: 100vh;
      padding: var(--spacing-m);
    }

    .product-accordions {
      margin-top: auto;
    }

    /* Text column sticks to the top for as long as the images scroll past it
       (its grid cell ends with the section). Full viewport height so the
       accordions stay pinned to the bottom edge. */
    .product-boxes {
      position: sticky;
      top: var(--spacing-m);
      align-self: start;
      height: calc(100vh - var(--spacing-m) * 2);
    }

    .product-bg-slider {
      display: none;
    }

    .product-images {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xxs);
    }
  }

  /* Every item is a square, cropped to fill (object-fit: cover) — same ratio
     as the mobile slider. */
  .product-images .product-media-item {
    aspect-ratio: 1 / 1;
    border-radius: var(--rad-s);
    overflow: hidden;
  }

  .product-images .product-media-item img,
  .product-images .product-media-item video,
  .product-images .product-media-item iframe,
  .product-images .product-media-item model-viewer {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  /* When the frequency dropdown is showing, the buy row tucks up under it with
     the same xxxs gap as qty ↔ add to cart (cancels the purchase stack's xs). */
  .product-subscription:has(.subscription-frequency:not([hidden])) + .product-buy-row {
    margin-top: calc(var(--spacing-xxxs) - var(--spacing-xs));
  }

  /* Buy row: bare qty stepper + button. CSS Grid (not flex): `auto` sizes the
     qty column to its content and `1fr` takes the rest, so the stepper can't
     push past the row's right edge. Height matches an accordion summary row. */
  .product-buy-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    gap: var(--spacing-xxxs);
    width: 100%;
    min-height: calc(var(--spacing-xxs) * 2 + var(--type-ui-size) * 1.2);
  }

  /* Add-to-cart cell. .product-buy-add is a flex container so the existing
     .buy-buttons → .button chain fills both axes (flex: 1 + stretch). */
  .product-buy-add {
    min-width: 0;
    display: flex;
  }

  /* Add-to-cart label overrides for this PDP context only: left-aligned,
     .text-ui typography (14px / 1.2em / no transform) instead of the
     uppercase .text-h1 base. Weight stays 500. */
  .product-buy-add .button {
    text-align: left;
    font-size: var(--type-ui-size);
    line-height: var(--type-ui-height);
    letter-spacing: var(--type-ui-spacing);
    text-transform: none;
  }

  /* Label on the left, price on the right. Inner flex wrapper because
     .button itself stays inline-block per the convention. */
  .buy-button-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-xs);
    width: 100%;
  }

  .product-buy-add .buy-buttons {
    flex: 1;
    min-width: 0;
  }

  /* Qty cell: each layer (.product-buy-qty > <quantity-selector> >
     .quantity-selector) stretches so the visible slab matches the button
     height. */
  .product-buy-qty {
    display: flex;
    align-items: stretch;
  }

  .product-buy-qty quantity-selector {
    display: flex;
    flex: 1;
    align-self: stretch;
  }

  .product-buy-qty .quantity-selector {
    flex: 1;
    align-self: stretch;
  }

  .product-variants {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .variant-options {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .buy-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-s);
    align-items: stretch;
  }

  .buy-buttons .button {
    flex: 1;
  }

  /* Hairline accordion rows: a rule above each, plus one under the last. */
  .product-accordion {
    border-top: 1px solid var(--color-border);
  }

  .product-accordion:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .product-accordion summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-xs) 0;
    cursor: pointer;
    list-style: none;
  }

  .product-accordion summary::-webkit-details-marker {
    display: none;
  }

  /* Accordion icon: plus by default, crossfades to minus when open. Both SVGs
     are stacked (absolute) inside the 1em box so they can fade rather than
     swap; the + visually contains the - (its horizontal bar), so the crossfade
     reads as the vertical stroke dissolving. currentColor inherits from the
     summary; sized to ~1em to match the .text-ui label beside it. */
  .product-accordion-icon {
    flex-shrink: 0;
    position: relative;
    display: inline-flex;
    width: 1em;
    height: 1em;
  }

  .product-accordion-icon svg {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.8em;
    height: auto;
  }

  /* Closed: plus visible, minus hidden. */
  .product-accordion-icon .icon-minus {
    opacity: 0;
  }

  /* No-JS baseline: native [open] swaps via opacity (instant — the crossfade
     transition is only added under [data-enhanced] below). */
  .product-accordion[open] .product-accordion-icon .icon-plus {
    opacity: 0;
  }

  .product-accordion[open] .product-accordion-icon .icon-minus {
    opacity: 1;
  }

  /* Enhanced: animate the crossfade, driven off .is-open (set at the start of
     the tween) so it co-times with the body and starts un-fading the moment a
     close begins, rather than lagging until [open] is finally dropped. */
  accordion-list[data-enhanced] .product-accordion-icon svg {
    transition: opacity 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  accordion-list[data-enhanced] details:not(.is-open) .product-accordion-icon .icon-plus {
    opacity: 1;
  }

  accordion-list[data-enhanced] details:not(.is-open) .product-accordion-icon .icon-minus {
    opacity: 0;
  }

  accordion-list[data-enhanced] details.is-open .product-accordion-icon .icon-plus {
    opacity: 0;
  }

  accordion-list[data-enhanced] details.is-open .product-accordion-icon .icon-minus {
    opacity: 1;
  }

  .product-accordion-content {
    padding-bottom: var(--spacing-xs);
  }

  /* Richtext + the "View full nutrition" trigger stack with a consistent gap,
     and the gap collapses cleanly when the richtext is absent. */
  .product-nutrition-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
    align-items: flex-start;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-accordion-icon svg,
    .product-bg-slider-btn {
      transition: none;
    }
  }

  product-form.is-loading [data-variant-render] {
    opacity: 0.6;
    pointer-events: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "text",
      "id": "subscription_title",
      "label": "Subscription accordion title",
      "default": "Subscription"
    },
    {
      "type": "richtext",
      "id": "subscription_info",
      "label": "Subscription accordion text",
      "info": "Shown in the Subscription accordion on products with a subscription plan. Leave empty to hide the accordion.",
      "default": "<p>Subscribe and save 10% on every delivery. Skip, pause or cancel any time.</p>"
    },
    {
      "type": "url",
      "id": "subscription_info_link",
      "label": "Subscription info link",
      "info": "Shown as an info icon next to the subscription option. Opens in a new tab."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
