<div class="page">
  <header class="page-header">
    {%- comment -%} Semantic H1, visual H2 scale — the largest visible heading on the page. {%- endcomment -%}
    <h1 class="page-title text-h2">{{ page.title }}</h1>
  </header>

  {%- if page.content != blank -%}
    <div class="page-content typeset">
      {{ page.content }}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .page {
    max-width: 720px;
    margin-inline: auto;
    /* The layout already reserves the fixed header (base.css §26); l is the
       gap below the floating nav. */
    padding: var(--spacing-l) var(--spacing-s);
  }

  @media (min-width: 900px) {
    .page {
      padding: var(--spacing-l) var(--spacing-m) var(--spacing-xl);
    }
  }

  .page-title {
    margin-bottom: var(--spacing-m);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
