{%- comment -%}
  Frood Hero (Landing) — duplicate of sections/hero.liquid, with every CSS
  class renamed (hero-frood-landing-*) to avoid colliding with the original
  in Shopify's theme-wide compiled stylesheet, since both are used
  simultaneously on the live theme. Keep in sync manually if the base
  hero.liquid changes.

  Frood Hero — full-bleed background video with the Frood logo centered in accent yellow.
  100vh tall, fills page width. Logo is the inline SVG snippet logo-frood (recolorable via currentColor).
  Video is bundled in the theme (assets/frood-hero.mp4) so Shopify's HLS transcoder doesn't
  re-encode it. The background image acts as the poster + still fallback (defaults to dummy.jpg).
  See CLAUDE.md → "Frood Hero section" for design rules.
{%- endcomment -%}

<section class="hero-frood-landing">
  {%- if section.settings.background_image != blank -%}
    {%- assign hero_poster = section.settings.background_image | image_url: width: 2400 -%}
  {%- else -%}
    {%- assign hero_poster = 'dummy.jpg' | asset_url -%}
  {%- endif -%}

  <video
    class="hero-frood-landing-bg"
    src="{{ 'frood-hero.mp4' | asset_url }}"
    poster="{{ hero_poster }}"
    autoplay
    loop
    muted
    playsinline
    width="1920"
    height="1080"
  ></video>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div
      class="hero-frood-landing-overlay"
      style="--hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"
    ></div>
  {%- endif -%}

  <div class="hero-frood-landing-logo">
    {% render 'logo-frood' %}
  </div>

  {%- if section.settings.product != blank -%}
    {%- assign feat_product = section.settings.product -%}
    {%- assign render_video = feat_product.metafields.custom.product_render_video.value -%}
    <div class="hero-frood-landing-feature">
      <div class="hero-frood-landing-feature-card">
        <div class="hero-frood-landing-feature-text">
          {%- if section.settings.heading != blank -%}
            <div class="text-h3 hero-frood-landing-feature-heading">{{ section.settings.heading }}</div>
          {%- endif -%}
          {%- if section.blocks.size > 0 -%}
            <ul class="hero-frood-landing-benefits">
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}
                  <li class="hero-frood-landing-benefit" {{ block.shopify_attributes }}>
                    {% render 'icon-check-circle' %}
                    <span class="text-ui text-cap">{{ block.settings.text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
        <div class="hero-frood-landing-feature-media">
          {%- if render_video != blank -%}
            <product-render-video
              class="hero-frood-landing-feature-image"
              loop-delay="10000"
              defer-first-play-until=".hero-frood-landing-feature-card"
            >
              {{
                render_video
                | video_tag:
                  autoplay: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'auto'
              }}
            </product-render-video>
          {%- elsif feat_product.featured_image -%}
            <div class="hero-frood-landing-feature-image">
              {{ feat_product.featured_image | image_url: width: 480 | image_tag:
                loading: 'lazy',
                alt: feat_product.featured_image.alt | default: feat_product.title,
                width: feat_product.featured_image.width,
                height: feat_product.featured_image.height
              }}
            </div>
          {%- endif -%}
          <a href="{{ feat_product.url }}" class="button hero-frood-landing-feature-cta">{{ 'general.shop_now' | t }}</a>
        </div>
      </div>
    </div>
    <script src="{{ 'product-render-video.js' | asset_url }}" defer></script>
  {%- endif -%}
</section>

{% stylesheet %}
  .hero-frood-landing {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .hero-frood-landing-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-frood-landing-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-text);
    opacity: var(--hero-overlay-opacity, 0.3);
    pointer-events: none;
  }

  .hero-frood-landing-logo {
    position: absolute;
    top: var(--spacing-xxs);
    left: var(--spacing-xxs);
    z-index: 1;
    width: 187px;
    color: var(--color-accent);
    /* Fades in after the header stagger finishes (~0.6s) */
    opacity: 0;
    transform: scale(0.98);
    animation: hero-logo-in-landing 0.5s ease-out 0.6s forwards;
  }

  .hero-frood-landing-logo svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 600px) {
    .hero-frood-landing-logo {
      width: 234px;
    }
  }

  /* Max size — the wordmark caps out here on desktop. */
  @media (min-width: 900px) {
    .hero-frood-landing-logo {
      width: 293px;
    }
  }

  /* Hidden on mobile — the feature card takes over that space instead. */
  @media (max-width: 599.98px) {
    .hero-frood-landing-logo {
      display: none;
    }
  }

  @keyframes hero-logo-in-landing {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-frood-landing-logo {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .hero-frood-landing-feature {
    position: absolute;
    bottom: var(--spacing-xxs);
    right: var(--spacing-xxs);
    z-index: 2;
    max-width: calc(100% - var(--spacing-xxs) * 2);
  }

  /* Mobile: the card takes over the wordmark's spot, stacked (not the
     row/flex layout used at tablet+), 75% of the section's width, in
     reading order: heading, image, benefits, then the CTA.
     Grid + named grid-area (not flex `order`) reorders these reliably —
     `order` combined with `display: contents` has known cross-browser
     reliability issues, which is what broke this the first time round. */
  @media (max-width: 599.98px) {
    .hero-frood-landing-feature {
      left: var(--spacing-xxs);
      right: auto;
      width: 75%;
    }

    .hero-frood-landing-feature-card {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        "heading"
        "image"
        "benefits"
        "cta";
    }

    /* Un-boxes the text/media groupings so heading, image, benefits and CTA
       become direct grid children of the card — letting grid-area place
       them regardless of their markup grouping. */
    .hero-frood-landing-feature-text,
    .hero-frood-landing-feature-media {
      display: contents;
    }

    .hero-frood-landing-feature-heading {
      grid-area: heading;
    }

    .hero-frood-landing-feature-image {
      grid-area: image;
      width: 100%;
    }

    .hero-frood-landing-benefits {
      grid-area: benefits;
    }

    .hero-frood-landing-feature-cta {
      grid-area: cta;
    }
  }

  @media (min-width: 600px) {
    .hero-frood-landing-feature {
      width: 380px;
    }
  }

  /* Desktop: the dominant card, pinned to the video's frame seam (at 50vw).
     left + right (no explicit width) so the browser computes the width as
     the gap between them — the same spacing-xxs inset on both sides, so the
     gap off the seam matches the gap off the viewport's right edge. */
  @media (min-width: 900px) {
    .hero-frood-landing-feature {
      left: calc(50vw + var(--spacing-xxxs));
      width: auto;
    }
  }

  .hero-frood-landing-feature-card {
    background-color: var(--color-bg-dark);
    border-radius: var(--rad-s);
    padding: var(--spacing-s);
    display: flex;
    align-items: flex-end;
    gap: var(--spacing-s);
    color: var(--color-text);
    /* Fades in after the logo settles (logo finishes at ~1.1s) */
    opacity: 0;
    transform: translateY(8px);
    animation: hero-feature-in-landing 0.5s ease-out 1.1s forwards;
  }

  .hero-frood-landing-feature-text {
    flex: 1 1 auto;
    min-width: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-frood-landing-feature-heading {
    margin: 0;
    max-width: 30ch;
  }

  .hero-frood-landing-benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
  }

  .hero-frood-landing-benefit {
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
  }

  /* .text-cap's default letter-spacing (0.066em) reads too wide at this
     size — dial it back just for the benefit label, not the shared utility
     (used elsewhere: main-search, product-variant-selector). */
  .hero-frood-landing-benefit .text-cap {
    letter-spacing: 0.02em;
  }

  .hero-frood-landing-benefit svg {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    margin-bottom: 3px;
  }

  .hero-frood-landing-feature-media {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--spacing-xxs);
  }

  .hero-frood-landing-feature-image {
    display: block;
    width: 96px;
  }

  @media (min-width: 900px) {
    .hero-frood-landing-feature-image {
      width: 140px;
    }
  }

  .hero-frood-landing-feature-image video,
  .hero-frood-landing-feature-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-frood-landing-feature-cta {
    width: 100%;
    opacity: 0;
    transform: translateY(8px);
    animation: hero-feature-in-landing 0.5s ease-out 1.25s forwards;
  }

  @keyframes hero-feature-in-landing {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-frood-landing-feature-card,
    .hero-frood-landing-feature-cta {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Frood Hero (Landing)",
  "tag": "section",
  "class": "section-frood-hero-landing",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Poster image",
      "info": "Shown before the video loads and as a still fallback. The hero video itself lives in the theme (assets/frood-hero.mp4) — ask a dev to swap it."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "info": "Burgundy scrim over the video. Helps the wordmark and feature card pop.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Featured product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>The hours are already in the pouch.</p><p>Dinner is fifteen minutes away.</p>"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text",
          "default": "Real whole produce"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frood Hero (Landing)",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Real whole produce" } },
        { "type": "benefit", "settings": { "text": "No long ingredient lists" } },
        { "type": "benefit", "settings": { "text": "Works for every diet" } }
      ]
    }
  ]
}
{% endschema %}
