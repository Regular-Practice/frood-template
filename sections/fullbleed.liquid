{%- comment -%}
  Frood Full-bleed — large media (image or video) at viewport height (100vh
  or 75vh). Optional outer margins (padding m around the section) and an
  optional caption card sitting inside the media at bottom-left.

  Two media modes:
    - Fixed-height (default): the section is 100/75vh and the media fills it
      via object-fit: cover (crops to frame).
    - Keep ratio: the section sizes to the media's natural ratio — media is
      100% wide, height auto, no cropping. The height select is ignored.

  Video is preferred over image when both are set.
{%- endcomment -%}

<section
  class="fullbleed-section height-{{ section.settings.height }}{% if section.settings.margins %} has-margins{% endif %}{% if section.settings.keep_ratio %} keep-ratio{% endif %}"
>
  <div class="fullbleed-frame">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'fullbleed-media'
      }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '375, 750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          width: section.settings.image.width,
          height: section.settings.image.height,
          class: 'fullbleed-media'
      }}
    {%- else -%}
      <div class="fullbleed-media placeholder" aria-hidden="true"></div>
    {%- endif -%}

    {%- comment -%}
      Quote and caption are mutually exclusive — when "Add quote" is on, the
      caption is suppressed even if its fields are filled in.
    {%- endcomment -%}
    {%- if section.settings.add_quote -%}
      <div class="fullbleed-quote">
        {%- if section.settings.quote_eyebrow != blank -%}
          <h1 class="text-h1">{{ section.settings.quote_eyebrow }}</h1>
        {%- endif -%}
        {%- if section.settings.quote_heading != blank -%}
          <h2 class="text-h2">{{ section.settings.quote_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.quote_button_text != blank and section.settings.quote_button_link != blank -%}
          <a class="button fullbleed-quote-button" href="{{ section.settings.quote_button_link }}">{{ section.settings.quote_button_text }}</a>
        {%- endif -%}
      </div>
    {%- elsif section.settings.caption_heading != blank or section.settings.caption_body != blank -%}
      <div class="fullbleed-caption">
        {%- if section.settings.caption_heading != blank -%}
          <h1 class="text-h1">{{ section.settings.caption_heading }}</h1>
        {%- endif -%}
        {%- if section.settings.caption_body != blank -%}
          <div class="fullbleed-caption-body text-body">{{ section.settings.caption_body }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .fullbleed-section {
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  /* Fixed-height modes — the height select determines section height. */
  .fullbleed-section.height-100:not(.keep-ratio) { height: 100vh; }
  .fullbleed-section.height-75:not(.keep-ratio) { height: 75vh; }

  .fullbleed-section.has-margins {
    padding: var(--spacing-xs);
  }

  @media (min-width: 900px) {
    .fullbleed-section.has-margins {
      padding: var(--spacing-m);
    }
  }

  /* Mobile (<600px): force full-bleed even if the merchant turned margins on.
     Phones have little horizontal room — margins around a hero/feature media
     just rob it of impact. Tablet (≥600px) and desktop (≥900px) still honour
     the .has-margins setting. */
  @media (max-width: 599.98px) {
    .fullbleed-section.has-margins {
      padding: 0;
    }
  }

  .fullbleed-frame {
    position: relative;
    width: 100%;
    height: 100%;
    padding: var(--spacing-xxs);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  }

  .fullbleed-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-overlay);
    pointer-events: none;
    z-index: 1;
  }

  /* When the section has a quote on the media, double the overlay strength
     so the quote stays legible against the photo.
     --color-overlay is --color-text @ 10%; this is @ 20%. */
  .fullbleed-frame:has(.fullbleed-quote)::after {
    background-color: color-mix(in srgb, var(--color-text) 20%, transparent);
  }

  /* Media (image / video / placeholder) — in fixed-height mode it fills the
     frame via object-fit: cover. */
  .fullbleed-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .fullbleed-media.placeholder {
    background: var(--color-bg-dark);
  }

  /* Keep-ratio mode — the section/frame size to the media's natural ratio.
     Width is 100% of the container; height is auto so the image/video keeps
     its aspect ratio (no crop). The height select is ignored. */
  .fullbleed-section.keep-ratio,
  .fullbleed-section.keep-ratio .fullbleed-frame {
    height: auto;
  }

  /* Drop the frame's xxs inner padding — in fixed-height mode the media is
     position:absolute and ignores the padding, but in keep-ratio mode the
     media is position:static and respects it, leaving a visible 8px gap
     around the media that shows the section bg through. */
  .fullbleed-section.keep-ratio .fullbleed-frame {
    padding: 0;
  }

  .fullbleed-section.keep-ratio .fullbleed-media {
    position: static;
    width: 100%;
    height: auto;
    object-fit: initial;
  }

  /* Caption needs to be absolutely anchored in keep-ratio mode (the frame is
     no longer 100% height, so flex alignment doesn't keep it bottom-left). */
  .fullbleed-section.keep-ratio .fullbleed-caption {
    position: absolute;
    bottom: var(--spacing-xxs);
    left: var(--spacing-xxs);
  }

  .fullbleed-caption {
    position: relative;
    z-index: 2;
    background-color: var(--color-bg-dark);
    border-radius: var(--rad-s);
    padding: var(--spacing-xxs);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
    max-width: 36ch;
  }

  .fullbleed-caption p {
    margin: 0;
  }

  /* Richtext caption body — kill default p spacing, keep paragraph gaps tight */
  .fullbleed-caption-body p + p {
    margin-top: var(--spacing-xxs);
  }

  /* Quote overlay — centered text on the media, mirroring the Quote section's
     lockup (eyebrow + heading + optional button). No card surface — just text
     directly on the image. Mutually exclusive with the caption. */
  .fullbleed-quote {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    color: var(--color-bg);
    width: calc(100% - var(--spacing-m));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-xxs);
  }

  @media (min-width: 900px) {
    .fullbleed-quote {
      width: 75%;
    }
  }

  @media (min-width: 1200px) {
    .fullbleed-quote {
      width: 50%;
    }
  }

  .fullbleed-quote h2 {
    max-width: 24ch;
  }

  /* Brand rule override: .text-h1 is normally locked to --color-text-accent
     (warm muted grey). Here it's explicitly overridden to --color-bg so it
     reads on the photo with the rest of the quote text. */
  .fullbleed-quote .text-h1 {
    color: var(--color-bg);
  }

  /* m margin-top above the button. Stacks with the .fullbleed-quote flex gap
     (xxs), so total spacing under the h2 is xxs + m = 32px — same treatment
     as .quote-button in the Quote section. */
  .fullbleed-quote-button {
    margin-top: var(--spacing-m);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Full-bleed",
  "tag": "section",
  "class": "fullbleed-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional. When set, takes precedence over the image."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "info": "Ignored when \"Keep ratio\" is on.",
      "options": [
        { "value": "100", "label": "Full viewport (100vh)" },
        { "value": "75", "label": "Three-quarters viewport (75vh)" }
      ],
      "default": "100"
    },
    {
      "type": "checkbox",
      "id": "keep_ratio",
      "label": "Keep ratio",
      "info": "When on, the section sizes to the media's natural aspect ratio (width 100%, height auto). When off, the section uses the height above and the media crops to fill via object-fit: cover.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "margins",
      "label": "Margins",
      "info": "When on, the image sits inside section padding. When off, it goes edge-to-edge.",
      "default": false
    },
    {
      "type": "header",
      "content": "Caption"
    },
    {
      "type": "paragraph",
      "content": "Hidden when \"Add quote\" is on — the two are mutually exclusive."
    },
    {
      "type": "text",
      "id": "caption_heading",
      "label": "Caption heading (h1 — small uppercase label)"
    },
    {
      "type": "richtext",
      "id": "caption_body",
      "label": "Caption body"
    },
    {
      "type": "header",
      "content": "Quote overlay"
    },
    {
      "type": "checkbox",
      "id": "add_quote",
      "label": "Add quote",
      "info": "When on, replaces the caption with a centered off-white quote card (same design as the Quote section).",
      "default": false
    },
    {
      "type": "text",
      "id": "quote_eyebrow",
      "label": "Quote eyebrow (h1 — small uppercase label)"
    },
    {
      "type": "textarea",
      "id": "quote_heading",
      "label": "Quote heading (h2)"
    },
    {
      "type": "text",
      "id": "quote_button_text",
      "label": "Quote button label"
    },
    {
      "type": "url",
      "id": "quote_button_link",
      "label": "Quote button link",
      "info": "Both label and link must be set for the button to appear."
    }
  ],
  "presets": [
    {
      "name": "Full-bleed"
    }
  ]
}
{% endschema %}
