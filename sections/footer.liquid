<footer class="footer">
  <div class="footer-brand">
    <div class="footer-icon">{% render 'logo-frood' %}</div>
    {%- assign current_year = 'now' | date: '%Y' -%}
    <p class="footer-copyright text-h1">{{ 'footer.copyright' | t: year: current_year, shop_name: shop.name }}</p>
  </div>

  <div class="footer-right">
    <div class="footer-links">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer-column-heading text-h1">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer-column-links">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer-link text-ui">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</footer>

{% stylesheet %}
  /* Mobile + tablet (<900px): tight xs padding. Desktop+ steps up to m. */
  .footer {
    background-color: var(--color-bg);
    color: var(--color-text);
    padding: var(--spacing-xs);
    display: flex;
    /* Mobile + tablet: reversed column so the icon brand block sits at the bottom */
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: var(--spacing-l);
  }

  /* On wider viewports: brand left, links + newsletter right, with space between. */
  @media (min-width: 900px) {
    .footer {
      padding: var(--spacing-m);
      flex-direction: row;
      justify-content: space-between;
      gap: var(--spacing-m);
    }
  }

  /* Brand (left on desktop, bottom on mobile + tablet) */
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xxs);
    flex: 0 0 auto;
    width: 100%;
  }

  @media (min-width: 900px) {
    .footer-brand {
      width: auto;
      align-items: flex-start;
    }
  }

  .footer-icon {
    width: 80%;
    color: var(--color-text);
  }

  @media (min-width: 900px) {
    .footer-icon {
      width: 500px;
    }
  }

  .footer-icon svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .footer-copyright {
    margin: 0;
  }

  /* Right block (links column). Mobile + tablet: full row width so the grid
     can stretch across. Desktop (≥900px): capped at 500px so the link grid
     sits compact against the right edge. */
  .footer-right {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-l);
    flex: 1;
    width: 100%;
  }

  /* Tablet (600–899px): footer-right takes the full row width and the link
     grid lays out horizontally as a single row of columns (one column per
     link_list block) instead of the default 2×2 wrap. */
  @media (min-width: 600px) and (max-width: 899px) {
    .footer-right {
      width: 100%;
    }

    .footer-links {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 900px) {
    .footer-right {
      max-width: 500px;
    }
  }

  /* Links grid (2 columns) */
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-m);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
  }

  .footer-column-heading {
    margin: 0;
  }

  .footer-column-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxxs);
  }

  .footer-link {
    color: var(--color-text);
    text-decoration: none;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_list"
        },
        {
          "type": "link_list"
        }
      ]
    }
  ]
}
{% endschema %}
