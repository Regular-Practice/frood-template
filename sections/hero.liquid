{%- comment -%}
  Frood Hero — full-bleed image hero with the Frood logo in accent yellow.
  100vh tall, fills page width. Logo is the inline SVG snippet logo-frood (recolorable via currentColor).
  The logo shows on desktop only (>=900px) — below that it clashed with the navbar.
  Tablet and smaller (<900px): the primary image is the full-bleed background.
  Desktop (>=900px): 50/50 split — primary image left, secondary image right. With no secondary
  image, the primary fills the whole width. Primary defaults to dummy.jpg when unset.
  See CLAUDE.md → "Frood Hero section" for design rules.
{%- endcomment -%}

<section class="hero-frood">
  <div class="hero-frood-bg{% unless section.settings.secondary_image != blank %} is-single{% endunless %}">
    {%- if section.settings.background_image != blank -%}
      {{ section.settings.background_image | image_url: width: 2400 | image_tag:
        class: 'hero-frood-image hero-frood-image-primary',
        loading: 'eager',
        fetchpriority: 'high',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '(min-width: 900px) 50vw, 100vw',
        alt: section.settings.background_image.alt
      }}
    {%- else -%}
      <img
        class="hero-frood-image hero-frood-image-primary"
        src="{{ 'dummy.jpg' | asset_url }}"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      >
    {%- endif -%}
    {%- if section.settings.secondary_image != blank -%}
      {{ section.settings.secondary_image | image_url: width: 1500 | image_tag:
        class: 'hero-frood-image hero-frood-image-secondary',
        loading: 'eager',
        widths: '750, 1100, 1500, 2000',
        sizes: '50vw',
        alt: section.settings.secondary_image.alt
      }}
    {%- endif -%}
  </div>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div
      class="hero-frood-overlay"
      style="--hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"
    ></div>
  {%- endif -%}

  <div class="hero-frood-logo">
    {% render 'logo-frood' %}
  </div>

  {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank -%}
    <div class="hero-frood-card">
      {%- if section.settings.heading != blank -%}
        <div class="text-h3 hero-frood-card-heading">{{ section.settings.heading }}</div>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="text-body hero-frood-card-text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="button hero-frood-card-cta"
        >{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .hero-frood {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .hero-frood-bg {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr;
  }

  .hero-frood-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Secondary image only exists from desktop up — tablet and smaller show
     the primary alone. */
  .hero-frood-image-secondary {
    display: none;
  }

  @media (min-width: 900px) {
    .hero-frood-bg:not(.is-single) {
      grid-template-columns: 1fr 1fr;
    }

    .hero-frood-image-secondary {
      display: block;
    }
  }

  .hero-frood-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-text);
    opacity: var(--hero-overlay-opacity, 0.3);
    pointer-events: none;
  }

  /* Desktop only — hidden below 900px where it clashed with the navbar. */
  .hero-frood-logo {
    display: none;
    position: absolute;
    top: var(--spacing-xxs);
    left: var(--spacing-xxs);
    z-index: 1;
    width: 293px;
    color: var(--color-accent);
    /* Fades in after the header stagger finishes (~0.6s) */
    opacity: 0;
    transform: scale(0.98);
    animation: hero-logo-in 0.5s ease-out 0.6s forwards;
  }

  @media (min-width: 900px) {
    .hero-frood-logo {
      display: block;
    }
  }

  .hero-frood-logo svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @keyframes hero-logo-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-frood-logo {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* Bottom-left card, inset by spacing-xxs from the frame like the wordmark.
     Full width on mobile; a fixed-ish column from tablet up. */
  .hero-frood-card {
    position: absolute;
    left: var(--spacing-xxs);
    right: var(--spacing-xxs);
    bottom: var(--spacing-xxs);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
    padding: var(--spacing-s);
    background-color: var(--color-bg);
    border-radius: var(--rad-s);
    color: var(--color-text);
    /* Fades in after the logo settles (logo finishes at ~1.1s) */
    opacity: 0;
    transform: translateY(8px);
    animation: hero-card-in 0.5s ease-out 1.1s forwards;
  }

  @media (min-width: 600px) {
    .hero-frood-card {
      right: auto;
      width: 480px;
    }
  }

  .hero-frood-card-heading p,
  .hero-frood-card-text p {
    margin: 0;
  }

  .hero-frood-card-text {
    max-width: 44ch;
  }

  .hero-frood-card-cta {
    width: 100%;
    text-align: center;
  }

  @keyframes hero-card-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-frood-card {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Frood Hero",
  "tag": "section",
  "class": "section-frood-hero",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Primary image",
      "info": "Full-bleed background on tablet and smaller; the left half on desktop."
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary image",
      "info": "Right half on desktop (900px and up). Not shown on tablet and smaller. Leave empty to let the primary image fill the width."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "info": "Burgundy scrim over the images. Helps the wordmark and card pop.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>We prep. You cook. Home made dinner in 20 minutes.</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Frood is a ready-to-cook vegetable and spice blend made from real ingredients and nothing else. Just add your protein for a meal packed with flavour.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get dinner sorted"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Frood Hero"
    }
  ]
}
{% endschema %}
