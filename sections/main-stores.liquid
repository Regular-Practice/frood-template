{%- comment -%}
  Frood Stores (stockists) locator — section-lockup header above a two-column
  store locator: a list of branches (left) beside a map of pins (right).
  Stacks on mobile (map on top). Loops the `stores` metaobject ONCE to render
  both the list rows and a JSON coordinate blob the map JS reads.

  The metaobject type handle is `store_locations`, referenced as
  `shop.metaobjects.store_locations`. If the handle in admin changes, swap the
  dot-key. The definition has these field handles:
    - retailer     single line text  (e.g. "Marks & Spencer" — eyebrow)
    - location      single line text  (branch, e.g. "Islington")
    - coordinates  single line text  ("lat, lng" — paste straight from a Google
                                       Maps right-click, e.g. "51.5362, -0.1033";
                                       store-map.js splits on the comma)
    - store_code   single line text  (optional — M&S internal number; never shown)

  List rows and the JSON array share the index (forloop.index0), so a row click
  maps to the right pin. Stores with blank/unparseable coordinates still list;
  they just get no pin.

  Scale: a metaobject list holds at most 250 entries per page, so the loop sits
  inside `paginate ... by 250`. Page 1 renders here (works with no JS); when
  there is a next page its URL is put on `data-next-url` and `store-map.js`
  fetches + merges the remaining pages, re-indexes, sorts A–Z and drives the
  search box and clustered pins. The three `data-count-*`/`data-no-results`
  attributes carry translated strings to that JS. The map is keyless — `store-map.js` lazy-loads MapLibre GL
  and renders OpenFreeMap vector tiles with a brand-coloured style, so there's no
  account, token, or section setting to configure for it.

  See CLAUDE.md → "Snippet Ownership" — `store-card` is owned by this section.
{%- endcomment -%}

<section class="stores-index">
  <header class="stores-index-header section-lockup">
    {%- if section.settings.eyebrow != blank -%}
      <h1 class="text-h1">{{ section.settings.eyebrow }}</h1>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h3 class="text-h3">{{ section.settings.heading | newline_to_br }}</h3>
    {%- endif -%}
  </header>

  {%- paginate shop.metaobjects.store_locations.values by 250 -%}
    {%- if paginate.items > 0 -%}
      <store-map
        class="stores-locator"
        {% if paginate.next %}data-next-url="{{ paginate.next.url }}"{% endif %}
        data-count-one="{{ 'stores.index.count' | t: count: 1 | replace: '1', '__COUNT__' }}"
        data-count-other="{{ 'stores.index.count' | t: count: 2 | replace: '2', '__COUNT__' }}"
      >
        <div class="stores-list-col">
          <div class="stores-search">
            <label class="visually-hidden" for="stores-search-input">{{ 'stores.index.search_label' | t }}</label>
            <input
              class="input text-ui"
              id="stores-search-input"
              type="search"
              autocomplete="off"
              placeholder="{{ 'stores.index.search_placeholder' | t }}"
              data-store-search
            >
            <p class="stores-status text-body" role="status" aria-live="polite" data-store-status></p>
          </div>

          <ul class="stores-list" role="list" data-store-list>
            {%- for store in shop.metaobjects.store_locations.values -%}
              {% render 'store-card', store: store, index: forloop.index0 %}
            {%- endfor -%}
          </ul>

          <p class="stores-no-results text-body" data-no-results hidden>
            {{ 'stores.index.no_results' | t }}
          </p>
        </div>

        <div class="stores-map-col">
          <div class="stores-map" data-map-canvas></div>
        </div>

        {%- comment -%} Coordinate blob — index-aligned with the list rows above. {%- endcomment -%}
        <script type="application/json" data-store-data>
          [
            {%- for store in shop.metaobjects.store_locations.values -%}
              {
                "retailer": {{ store.retailer | json }},
                "location": {{ store.location | json }},
                "coordinates": {{ store.coordinates | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
      </store-map>
    {%- else -%}
      <p class="stores-index-empty text-body">
        {{ 'stores.index.empty' | t }}
      </p>
    {%- endif -%}
  {%- endpaginate -%}
</section>

<script type="module" src="{{ 'store-map.js' | asset_url }}"></script>

{% stylesheet %}
  /* Padding system mirrors .news-index. */
  .stores-index {
    padding-top: var(--spacing-l);
    padding-inline: var(--spacing-xs);
    padding-bottom: var(--spacing-m);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  @media (min-width: 600px) {
    .stores-index {
      padding-top: var(--spacing-xl);
    }
  }

  @media (min-width: 900px) {
    .stores-index {
      padding-inline: var(--spacing-m);
    }
  }

  .stores-index-header {
    margin-bottom: var(--spacing-l);
  }

  .stores-index-header h3 {
    max-width: 36ch;
  }

  /* Locator: stacked on mobile (map first, then list); two columns on desktop
     with the list on the left and a sticky map on the right. The JSON <script>
     and any controls collapse out of flow. */
  .stores-locator {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-m);
  }

  .stores-locator [data-store-data] {
    display: none;
  }

  .stores-map {
    width: 100%;
    height: 320px;
    border-radius: var(--rad-s);
    overflow: hidden;
    background-color: var(--color-bg-dark);
  }

  /* If MapLibre fails to load (or no store has coordinates), hide the empty
     canvas rather than show a blank beige box — the list still works. */
  .stores-locator.is-map-unavailable .stores-map-col {
    display: none;
  }

  .stores-list-col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
    min-width: 0;
  }

  .stores-search {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
  }

  .stores-status,
  .stores-no-results {
    color: var(--color-text-accent);
  }

  .stores-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Rows hidden by the search box. */
  .stores-list .store-row.is-filtered-out {
    display: none;
  }

  /* With hundreds of stores the list scrolls inside its own column (desktop)
     so the map stays in view; on mobile it gets a capped height below the map. */
  .stores-list {
    max-height: 60vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* The rows' hover highlight bleeds --spacing-xs past the text (see
       store-card); the scroll box would clip that, so pad it back in here. */
    padding-inline: var(--spacing-xs);
    margin-inline: calc(-1 * var(--spacing-xs));
    scrollbar-width: thin;
    scrollbar-color: var(--color-text-accent) transparent;
  }

  @media (min-width: 900px) {
    .stores-locator {
      grid-template-columns: 2fr 3fr;
      align-items: start;
      gap: var(--spacing-l);
    }

    .stores-list-col {
      grid-column: 1;
      grid-row: 1;
    }

    .stores-list {
      max-height: calc(min(70vh, 640px) - 96px);
    }

    .stores-map-col {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: var(--spacing-m);
    }

    .stores-map {
      height: 70vh;
      max-height: 640px;
    }
  }

  /* Branded pin (MapLibre marker element — see store-map.js pinElement()). */
  .store-pin {
    cursor: pointer;
  }

  .store-pin-dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-text);
    box-shadow: 0 1px 4px var(--color-overlay);
    transition: transform var(--transition-fast);
  }

  /* Active = this store's row is focused — invert + enlarge so it stands out. */
  .store-pin.is-active .store-pin-dot {
    transform: scale(1.4);
    background: var(--color-text);
    border-color: var(--color-accent);
  }

  /* Keep the required OSM/OpenFreeMap credit, but small + muted so it recedes. */
  .stores-map .maplibregl-ctrl-attribution {
    font-size: 10px;
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
  }

  .stores-map .maplibregl-ctrl-attribution,
  .stores-map .maplibregl-ctrl-attribution a {
    color: var(--color-text-accent);
  }

  /* Keep MapLibre's popup in the Frood type system. */
  .maplibregl-popup-content {
    border-radius: var(--rad-s);
  }

  .maplibregl-popup-content .store-map-popup {
    color: var(--color-text);
  }

  .stores-index-empty {
    padding: var(--spacing-l) 0;
    color: var(--color-text-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stores locator",
  "tag": "section",
  "class": "stores-index-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (h1 — small uppercase label)",
      "default": "Stockists"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (h3)",
      "info": "Press Enter to add a line break.",
      "default": "Find Frood near you."
    }
  ],
  "presets": [
    {
      "name": "Stores locator"
    }
  ]
}
{% endschema %}
