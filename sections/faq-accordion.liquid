{%- comment -%}
  Frood FAQ — two-column editorial split (mirrors text-image-split).
  Left column: section-lockup (eyebrow + heading + optional contact link), pinned
  sticky on desktop. Right column: the accordion list.
  Mobile + tablet (<900px): stacks (intro above list).

  Accordion mechanics (smooth grid-rows close animation + no-JS fallback) are
  owned by <accordion-list> (assets/accordion.js) and base.css §24. This section
  only carries the visual layer. See the three-div contract below.
{%- endcomment -%}

<section class="faq">
  <div class="faq-intro">
    <header class="section-lockup">
      {%- if section.settings.eyebrow != blank -%}
        <h1 class="text-h1">{{ section.settings.eyebrow }}</h1>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h3 class="text-h3">{{ section.settings.heading | newline_to_br }}</h3>
      {%- endif -%}

      {%- if section.settings.link_text != blank -%}
        <a class="inline-link text-ui" href="{{ section.settings.link_url | default: '#' }}">
          {{ section.settings.link_text }}
        </a>
      {%- endif -%}
    </header>
  </div>

  {%- if section.blocks.size > 0 -%}
    <accordion-list class="faq-list" allow-multiple>
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-question text-ui">
            {{ block.settings.question }}
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          {%- comment -%}
            Three-div structure for the smooth grid-rows close animation:
            .accordion-content is the size-driven grid wrapper, -inner clips
            the overflow with no padding, and .faq-answer carries all padding.
            See assets/accordion.js for the contract.
          {%- endcomment -%}
          <div class="accordion-content">
            <div class="accordion-content-inner">
              <div class="faq-answer typeset">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        </details>
      {%- endfor -%}
    </accordion-list>
  {%- endif -%}
</section>

<script type="module" src="{{ 'accordion.js' | asset_url }}"></script>

{% stylesheet %}
  /* Mobile + tablet: single column, intro stacked above the list.
     Padding follows the responsive section rule (xs <900px, m ≥900px). */
  .faq {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-m);
    padding: var(--spacing-xs);
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  /* Phones-only: bump top/bottom for a touch more vertical breathing room. */
  @media (max-width: 599.98px) {
    .faq {
      padding-block: var(--spacing-m);
    }
  }

  /* When FAQ leads a page it sits under the fixed, floating header (~52px).
     Clear it the way main-page / the index pages do — header height plus
     editorial breathing room. Scoped to :first-child so a mid-page FAQ keeps
     its normal padding; the ID selector wins over the desktop grid's padding. */
  #main-content > .faq-section:first-child .faq {
    padding-top: calc(var(--header-height, 52px) + var(--spacing-l));
  }

  /* Heading caps like the rest of the theme; the desktop column narrows it further. */
  .faq-intro h3 {
    max-width: 36ch;
  }

  /* Contact link gets button-like separation from the heading (the lockup only
     gives non-button children --spacing-xxs by default). */
  .faq-intro .section-lockup > .inline-link {
    margin-top: var(--spacing-s);
  }

  /* Enclosed ledger: hairline above the first item + below every item.
     --color-border (text @ 10%) stays light across a long list, unlike the
     solid --color-text the news index uses for its handful of entries. */
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-s);
    padding: var(--spacing-s) 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  /* Refined rotating +: weight 400 (a hairline glyph against the .text-ui 500
     question), sized up as a clear affordance. Co-times with the body height. */
  .faq-icon {
    flex-shrink: 0;
    font-size: 1.5em;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* No-JS baseline: native [open] drives the icon. */
  details[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 0 var(--spacing-s) 0;
    max-width: 60ch;
  }

  /* Generic grid-rows mechanics live in base.css §24. Below: just the FAQ-specific
     bits — folding the summary gap into the animated body, and co-timing the icon. */

  /* The global open-summary gap is dropped under [data-enhanced] (base.css), so
     re-add it inside the animated body where it can tween instead of snap. */
  accordion-list[data-enhanced] .faq-answer {
    padding-top: var(--spacing-xs);
  }

  /* Drive the icon off .is-open (set at the start of the tween) rather than
     [open] (which lingers through the close), so it un-rotates in lock-step. */
  accordion-list[data-enhanced] details:not(.is-open) .faq-icon {
    transform: rotate(0deg);
  }

  /* Desktop: two-column split. align-items:start keeps the intro column
     content-sized so it can stick; the list column's height gives it room to travel. */
  @media (min-width: 900px) {
    .faq {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: var(--spacing-l);
      padding: var(--spacing-m);
      align-items: start;
    }

    .faq-intro {
      position: sticky;
      top: var(--spacing-m);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (h1 — small uppercase label)",
      "default": "FAQ"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (h3)",
      "info": "Press Enter to add a line break.",
      "default": "Everything you\nneed to know."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Contact link label",
      "info": "Low-emphasis underlined link below the heading. Leave blank to hide.",
      "default": "Still have questions? Get in touch"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Contact link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy on all items. Products must be in their original condition and packaging.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day return policy on all items. Products must be in their original condition and packaging.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Standard shipping typically takes 3-5 business days. Express shipping options are available at checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
