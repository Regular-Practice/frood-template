<section class="faq color-{{ section.settings.color_scheme }}">
  <div class="faq-container{% if section.settings.narrow_width %} faq-narrow{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-heading text-large">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="faq-subheading text-medium text-light">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <accordion-list class="faq-list" allow-multiple>
        {%- for block in section.blocks -%}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary class="faq-question">
              {{ block.settings.question }}
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            {%- comment -%}
              Three-div structure for the smooth grid-rows close animation:
              .accordion-content is the size-driven grid wrapper, -inner clips
              the overflow with no padding, and .faq-answer carries all padding.
              See assets/accordion.js for the contract.
            {%- endcomment -%}
            <div class="accordion-content">
              <div class="accordion-content-inner">
                <div class="faq-answer typeset">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          </details>
        {%- endfor -%}
      </accordion-list>
    {%- endif -%}
  </div>
</section>

<script type="module" src="{{ 'accordion.js' | asset_url }}"></script>

{% stylesheet %}
  .faq {
    padding: var(--spacing-l) var(--spacing-base);
  }

  @media (min-width: 600px) {
    .faq {
      padding: var(--spacing-xl) var(--spacing-m);
    }
  }

  .faq-narrow {
    max-width: 720px;
    margin-inline: auto;
  }

  .faq-heading {
    margin: 0 0 var(--spacing-s) 0;
  }

  .faq-subheading {
    margin: 0 0 var(--spacing-m) 0;
  }

  .faq-list {
    margin-top: var(--spacing-m);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-text-light);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-base) 0;
    cursor: pointer;
    list-style: none;
    font-weight: bold;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    flex-shrink: 0;
    font-size: var(--type-medium-size);
    line-height: 1;
    /* Match the body's duration + easing so the +/x icon co-times with the height. */
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* No-JS baseline: native [open] drives the icon. */
  details[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 0 var(--spacing-base) 0;
  }

  /* Generic grid-rows mechanics live in base.css section 24. Below: just the
     FAQ-specific bits — folding the summary gap into the animated body, and
     co-timing the icon. */

  /* The global open-summary gap is dropped under [data-enhanced] (base.css), so
     re-add it inside the animated body where it can tween instead of snap. */
  accordion-list[data-enhanced] .faq-answer {
    padding-top: var(--spacing-xs);
  }

  /* Drive the icon off .is-open (set at the start of the tween) rather than
     [open] (which lingers through the close), so it un-rotates in lock-step. */
  accordion-list[data-enhanced] details:not(.is-open) .faq-icon {
    transform: rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "label": "Narrow width",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy on all items. Products must be in their original condition and packaging.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day return policy on all items. Products must be in their original condition and packaging.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Standard shipping typically takes 3-5 business days. Express shipping options are available at checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
