<product-recommendations
  class="product-recommendations bg-tinted"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
>
  {%- capture lockup_header -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="product-recommendations-header section-lockup">
        {%- if section.settings.eyebrow != blank -%}
          <h2 class="text-h1">{{ section.settings.eyebrow }}</h2>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h3 class="text-h3">{{ section.settings.heading | newline_to_br }}</h3>
        {%- endif -%}
      </header>
    {%- endif -%}
  {%- endcapture -%}

  {%- if recommendations.performed? -%}
    {%- if recommendations.products_count > 0 -%}
      {{ lockup_header }}

      <div class="product-recommendations-grid grid grid-{{ section.settings.grid_columns }}">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    {%- comment -%} Skeleton placeholders shown until JS fetches recommendations {%- endcomment -%}
    {{ lockup_header }}

    <div class="product-recommendations-grid grid grid-{{ section.settings.grid_columns }}">
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="placeholder-card" aria-hidden="true"></div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</product-recommendations>

<script type="module" src="{{ 'product-recommendations.js' | asset_url }}"></script>

{% stylesheet %}
  .product-recommendations {
    display: block;
    padding: var(--spacing-m);
    color: var(--color-text);
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .product-recommendations-header {
    margin-bottom: var(--spacing-l);
  }

  .product-recommendations-header h3 {
    max-width: 36ch;
  }

  .product-recommendations-grid {
    display: grid;
    gap: var(--spacing-base);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 600px) {
    .product-recommendations-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .product-recommendations-grid.grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .placeholder-card {
    aspect-ratio: 3 / 4;
    background: var(--color-border, #e5e5e5);
    border-radius: var(--rad-s);
    animation: placeholder-pulse 1.5s ease-in-out infinite;
  }

  @keyframes placeholder-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .placeholder-card {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "product-recommendations-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (h1 — small uppercase label)",
      "default": "More to try"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (h3)",
      "info": "Press Enter to add a line break.",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "Grid columns (desktop)",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
