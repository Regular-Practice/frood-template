{%- comment -%}
  Product recommendations — pulls from a merchant-picked collection (typically
  "Shop") and excludes the product the visitor is currently viewing (when on a
  PDP). No Shopify ML recommendations API; just a curated collection feed,
  rendered at request time. Carousel on mobile + tablet, grid on desktop.
{%- endcomment -%}

{%- comment -%}
  Six-pack card layout (a / b / c) — the single theme setting (Theme settings →
  Products → Six-pack cards) shared with the collection and featured-collection
  sections (see snippets/product-card), so the cards match.
  Mixed Box first when on. This is a carousel/grid (not the 2-column mobile
  grid), so the Mixed Box never goes full-width here: `wide_breakpoint: 0` makes
  it always use its square image.
{%- endcomment -%}
{%- assign source_collection = section.settings.collection -%}
{%- assign six_layout = settings.six_pack_layout -%}
{%- if six_layout == 'off' -%}{%- assign six_layout = '' -%}{%- endif -%}
{%- if six_layout != blank -%}
  {%- assign has_six = false -%}
  {%- for sp_check in source_collection.products limit: 24 -%}
    {%- assign sp_check_size = sp_check.metafields.custom.pack_size.value | default: '' -%}
    {%- if sp_check.handle contains '6-pack' or sp_check_size contains '6' -%}
      {%- assign has_six = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- unless has_six -%}{%- assign six_layout = '' -%}{%- endunless -%}
{%- endif -%}

<section class="product-recommendations{% if six_layout != blank %} six-pack-on{% endif %}">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <header class="product-recommendations-header section-lockup">
      {%- if section.settings.eyebrow != blank -%}
        <h2 class="text-h1">{{ section.settings.eyebrow }}</h2>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h3 class="text-h3">{{ section.settings.heading | newline_to_br }}</h3>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- comment -%}
    Count how many candidates the source collection has after excluding the
    current product, so we can skip the carousel entirely if there's nothing
    to show. The actual exclusion happens inside the render loop below.
  {%- endcomment -%}
  {%- assign candidate_count = source_collection.products_count | default: 0 -%}
  {%- if product != blank and source_collection.products contains product -%}
    {%- assign candidate_count = candidate_count | minus: 1 -%}
  {%- endif -%}

  {%- if candidate_count > 0 -%}
    <product-recommendations-carousel>
      <div class="product-recommendations-viewport">
        <div class="product-recommendations-container grid-{{ section.settings.grid_columns }}">
          {%- assign shown = 0 -%}
          {%- if six_layout != blank -%}
            {%- for p in source_collection.products -%}
              {%- if p.handle contains 'mixed' and p.handle contains '6-pack' and p.id != product.id and shown < section.settings.products_to_show -%}
                <div class="product-recommendations-slide">
                  {% render 'product-card', product: p, six_pack_layout: six_layout, wide_breakpoint: 0 %}
                </div>
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for p in source_collection.products -%}
              {%- unless p.handle contains 'mixed' and p.handle contains '6-pack' -%}
                {%- if p.id != product.id and shown < section.settings.products_to_show -%}
                  <div class="product-recommendations-slide">
                    {% render 'product-card', product: p, six_pack_layout: six_layout, wide_breakpoint: 0 %}
                  </div>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- for p in source_collection.products -%}
              {%- if product != blank and p.id == product.id -%}
                {%- continue -%}
              {%- endif -%}
              {%- if shown >= section.settings.products_to_show -%}
                {%- break -%}
              {%- endif -%}
              <div class="product-recommendations-slide">
                {% render 'product-card', product: p %}
              </div>
              {%- assign shown = shown | plus: 1 -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <button
        class="product-recommendations-arrow product-recommendations-arrow-prev"
        type="button"
        data-direction="prev"
        aria-label="{{ 'general.accessibility.previous_slide' | t: default: 'Previous slide' }}"
        hidden
      >
        {% render 'icon-arrow' %}
      </button>
      <button
        class="product-recommendations-arrow product-recommendations-arrow-next"
        type="button"
        data-direction="next"
        aria-label="{{ 'general.accessibility.next_slide' | t: default: 'Next slide' }}"
        hidden
      >
        {% render 'icon-arrow' %}
      </button>
    </product-recommendations-carousel>
  {%- endif -%}
</section>

<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
<script src="{{ 'product-recommendations-carousel.js' | asset_url }}" defer></script>

{% stylesheet %}
  .product-recommendations {
    display: block;
    padding: var(--spacing-xs);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  /* Phones-only: bump top/bottom for a touch more vertical breathing room. */
  @media (max-width: 599.98px) {
    .product-recommendations {
      padding-block: var(--spacing-m);
    }
  }

  @media (min-width: 900px) {
    .product-recommendations {
      padding: var(--spacing-m);
    }
  }

  .product-recommendations-header {
    margin-bottom: var(--spacing-l);
  }

  .product-recommendations-header h3 {
    max-width: 36ch;
  }

  /* ───── Carousel (mobile + tablet) ───── */

  product-recommendations-carousel {
    display: block;
    position: relative;
  }

  .product-recommendations-viewport {
    overflow: hidden;
    margin-left: calc(-1 * var(--spacing-xs));
    margin-right: calc(-1 * var(--spacing-xs));
  }

  .product-recommendations-container {
    display: flex;
    touch-action: pan-y pinch-zoom;
  }

  product-recommendations-carousel.is-initialized .product-recommendations-viewport {
    cursor: grab;
  }

  product-recommendations-carousel.is-initialized .product-recommendations-viewport:active {
    cursor: grabbing;
  }

  .product-recommendations-slide {
    flex: 0 0 75%;
    min-width: 0;
  }

  @media (min-width: 600px) {
    .product-recommendations-slide {
      flex: 0 0 40%;
    }
  }

  /* Arrows — square accent-yellow background, dark arrow icon.
     Hidden via [hidden] when there's nothing more to scroll. */
  .product-recommendations-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    padding: 0;
    border: 0;
    border-radius: var(--rad-s);
    background: var(--color-accent);
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .product-recommendations-arrow[hidden] {
    display: none;
  }

  .product-recommendations-arrow:hover {
    background: var(--color-text);
    color: var(--color-accent);
  }

  .product-recommendations-arrow-prev {
    left: var(--spacing-xs);
  }

  .product-recommendations-arrow-next {
    right: var(--spacing-xs);
  }

  .product-recommendations-arrow-prev svg {
    transform: scaleX(-1);
  }

  /* ───── Grid (desktop) ───── */

  @media (min-width: 900px) {
    .product-recommendations-viewport {
      overflow: visible;
      margin-left: 0;
      margin-right: 0;
    }

    .product-recommendations-container {
      display: grid;
      gap: var(--spacing-base);
      grid-template-columns: repeat(3, 1fr);
      /* Clear Embla's inline transform when the carousel deactivates. */
      transform: none !important;
    }

    .product-recommendations-container.grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }

    .product-recommendations-slide {
      flex: initial;
    }

    .product-recommendations-arrow {
      display: none;
    }
  }
  /* ───── Six-pack layout spacing, A/B/C (matches featured-collection) ─────
     Room under the heading, a gap between slides and the carousel held inside the
     section padding. Desktop is the grid, which has its own gap. */
  @media (max-width: 899.98px) {
    .six-pack-on .product-recommendations-viewport {
      margin-left: 0;
      margin-right: 0;
    }

    .six-pack-on .product-recommendations-container {
      margin-left: calc(-1 * var(--spacing-s));
    }

    .six-pack-on .product-recommendations-slide {
      padding-left: var(--spacing-s);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "product-recommendations-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Source collection",
      "info": "Products from this collection are shown as recommendations. Typically the Shop collection. The currently-viewed product is automatically excluded."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (h1 — small uppercase label)",
      "default": "More to try"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (h3)",
      "info": "Press Enter to add a line break.",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "Grid columns (desktop)",
      "info": "Mobile and tablet show a drag-and-slide carousel.",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
