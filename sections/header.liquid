<header class="header">
  {%- comment -%} Mobile (<600px): "Menu" disclosure button that drops a panel of links below {%- endcomment -%}
  <details class="header-mobile-menu">
    <summary class="header-mobile-toggle text-ui">Menu</summary>
    <nav class="header-mobile-panel" aria-label="{{ 'header.navigation' | t }}">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="nav-link text-ui">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </details>

  {%- comment -%} Tablet+ (≥600px): bento nav grid {%- endcomment -%}
  <nav class="header-nav" aria-label="{{ 'header.navigation' | t }}">
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}" class="nav-link text-ui">{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <div class="header-right">
    <cart-icon data-aria-template="{{ 'accessibility.cart_count' | t: count: '__COUNT__' }}">
      <a
        href="{{ routes.cart_url }}"
        class="header-cart text-ui"
        aria-label="{{ 'accessibility.cart_count' | t: count: cart.item_count }}"
      >
        {{ 'header.cart' | t }} (<span class="cart-count">{{ cart.item_count }}</span>)
      </a>
    </cart-icon>
  </div>
</header>

<script type="module" src="{{ 'cart-icon.js' | asset_url }}"></script>

<script>
  (function () {
    var group = document.querySelector('.shopify-section-group-header-group');
    if (!group || group.children.length < 2) return;

    var firstSection = group.firstElementChild;
    function measure() {
      var h = firstSection.offsetHeight;
      group.style.setProperty('--header-group-offset', h + 'px');
    }

    measure();

    var ro = new ResizeObserver(measure);
    ro.observe(firstSection);
  })();
</script>

{% stylesheet %}
  :root {
    --header-height: 52px;
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9;
    background-color: transparent;
    color: var(--color-text);
    padding: var(--spacing-xxs);
    /* Mobile: flex layout so "Menu" disclosure fills space next to cart */
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-xxxs);
    /* The fixed wrapper spans the full viewport but is mostly empty space
       (transparent area around the centered bento nav). Let clicks pass
       through it; re-enable pointer events only on the interactive pieces. */
    pointer-events: none;
  }


  .header-mobile-menu,
  .header-mobile-toggle,
  .header-mobile-panel,
  .nav-link,
  .header-right {
    pointer-events: auto;
  }

  @media (min-width: 600px) {
    .header {
      /* Tablet+: revert to block layout so bento can center / cart can position absolutely */
      display: block;
    }
  }


  /* Mobile menu disclosure — "Menu" summary + dropdown panel.
     position: relative so the panel below positions itself against this
     disclosure (which is just the menu pill's height), not against .header
     (which is taller due to the cart's margin-top extending the flex row). */
  .header-mobile-menu {
    flex: 1;
    min-width: 0;
    position: relative;
  }

  .header-mobile-toggle {
    display: block;
    width: 100%;
    cursor: pointer;
    list-style: none;
    /* Same bento card styling as .nav-link */
    background-color: var(--color-nav);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-border);
    border-radius: var(--rad-s);
    padding: var(--spacing-xxs);
    text-align: left;
    color: var(--color-text);
    transition: background-color var(--transition-fast);
  }

  .header-mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .header-mobile-toggle:hover {
    background-color: var(--color-accent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header-mobile-menu[open] .header-mobile-toggle {
    background-color: var(--color-accent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    /* Override base.css's global `details[open] > summary { margin-bottom: xs }`
       — that's for product accordions on the PDP; the mobile menu sits flush
       to its absolutely-positioned panel. */
    margin-bottom: 0;
  }

  /* Dropdown panel — ONE pill container holding all nav-links as plain rows.
     Positions against .header-mobile-menu (just the menu pill's height) so
     the gap is exactly xxxs. Width is set explicitly to span the full viewport
     minus .header's xxs padding on each side; left: 0 starts the panel at the
     .header-mobile-menu's left edge (which is already at .header padding-left). */
  .header-mobile-panel {
    position: absolute;
    top: calc(100% + var(--spacing-xxxs));
    left: 0;
    width: calc(100vw - var(--spacing-xxs) * 2);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    /* Same bento card styling as .nav-link / .header-mobile-toggle */
    background-color: var(--color-nav);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-border);
    border-radius: var(--rad-s);
    padding: var(--spacing-xxs);
  }

  /* Inside the dropdown, links are bare rows — no individual pill chrome. The
     outer .header-mobile-panel is the only pill. */
  .header-mobile-panel .nav-link {
    grid-column: auto;
    display: block;
    width: 100%;
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 0;
    border-radius: 0;
    padding: 0;
  }

  .header-mobile-panel .nav-link:hover {
    background-color: transparent;
    color: var(--color-text);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Hide the mobile disclosure at tablet+ */
  @media (min-width: 600px) {
    .header-mobile-menu {
      display: none;
    }
  }

  /* Bento nav — hidden on mobile; 6-col grid on tablet+ */
  .header-nav {
    display: none;
  }

  @media (min-width: 600px) {
    .header-nav {
      max-width: 400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      column-gap: var(--spacing-xxxs);
      row-gap: var(--spacing-xxxs);
    }
  }

  /* Tablet (600–899px): left-align the bento so it sits opposite the right-aligned cart */
  @media (min-width: 600px) and (max-width: 899px) {
    .header-nav {
      margin: 0;
    }
  }

  .nav-link {
    /* default: 1/3 width (3 cells per row of 6 columns = span 2) */
    grid-column: span 2;
    background-color: var(--color-nav);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-border);
    border-radius: var(--rad-s);
    /* xxs all sides + 1px extra on the bottom (calc keeps the relationship to
       the token explicit — if --spacing-xxs changes, the bottom follows). */
    padding: var(--spacing-xxs) var(--spacing-xxs) calc(var(--spacing-xxs) + 1px);
    text-align: left;
    color: var(--color-text);
    transition: background-color var(--transition-fast);
  }

  .nav-link:hover {
    background-color: var(--color-accent);
    color: var(--color-text);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    opacity: 1;
  }

  .nav-link:active {
    background-color: var(--color-text);
    color: var(--color-accent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    opacity: 1;
  }

  /* First two links span half the grid (3 of 6 columns each) */
  .nav-link:nth-child(1),
  .nav-link:nth-child(2) {
    grid-column: span 3;
  }

  /* Cart: on mobile it sits in the flex flow next to the Menu disclosure (the
     flex container handles the xxxs gap). No top margin — its top edge lands at
     y=8 from the viewport (.header padding-top of xxs), matching the desktop
     cart's fixed top offset (top: xxs). On tablet+ it switches to fixed
     positioning at top-right. */
  .header-right {
    flex-shrink: 0;
  }

  @media (min-width: 600px) {
    .header-right {
      position: fixed;
      top: var(--spacing-xxs);
      right: var(--spacing-xxs);
    }
  }

  .header-cart {
    display: inline-block;
    background-color: var(--color-nav);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: 1px solid var(--color-border);
    border-radius: var(--rad-s);
    /* Match the nav-link chip: xxs all sides + 1px extra on the bottom. */
    padding: var(--spacing-xxs) var(--spacing-xxs) calc(var(--spacing-xxs) + 1px);
    color: var(--color-text);
    transition: background-color var(--transition-fast);
  }

  .header-cart:hover {
    background-color: var(--color-accent);
    color: var(--color-text);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    opacity: 1;
  }

  .header-cart:active {
    background-color: var(--color-text);
    color: var(--color-accent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    opacity: 1;
  }

  /* Staggered fade-in on page load — left to right, top to bottom. Nav-link
     + mobile-toggle slide in (translateY); the cart only fades because its
     own positioning (position: fixed; top: xxs) is what places it on screen
     — applying a translateY initial state would shift it ABOVE the intended
     position until the animation lands, which reads as "stuck to the top". */
  .nav-link,
  .header-mobile-toggle {
    opacity: 0;
    transform: translateY(-6px);
    animation: header-item-in 0.22s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .header-cart {
    opacity: 0;
    animation: header-cart-fade-in 0.22s ease forwards;
  }

  .header-mobile-toggle { animation-delay: 0.04s; }

  .nav-link:nth-child(1) { animation-delay: 0.04s; }
  .nav-link:nth-child(2) { animation-delay: 0.08s; }
  .nav-link:nth-child(3) { animation-delay: 0.12s; }
  .nav-link:nth-child(4) { animation-delay: 0.16s; }
  .nav-link:nth-child(5) { animation-delay: 0.20s; }
  .nav-link:nth-child(6) { animation-delay: 0.24s; }
  .nav-link:nth-child(7) { animation-delay: 0.28s; }
  .nav-link:nth-child(8) { animation-delay: 0.32s; }

  /* Cart appears after the nav links — fixed delay since it lives outside .header-nav */
  .header-cart { animation-delay: 0.36s; }

  @keyframes header-item-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes header-cart-fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .header-cart,
    .header-mobile-toggle {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
