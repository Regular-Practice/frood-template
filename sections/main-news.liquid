{%- comment -%}
  Frood News index — section-lockup header above a vertical stack of news cards.
  Loops through every entry of the `news` metaobject definition.

  Note: the metaobject type handle is referenced as `shop.metaobjects.news`.
  If the type handle in admin differs (e.g. `news_post`, `news_item`), swap the dot-key.
  See CLAUDE.md → "Snippet Ownership" — `news-card` is owned by this section.
{%- endcomment -%}

<section class="news-index color-{{ section.settings.color_scheme }}">
  <header class="news-index-header section-lockup">
    {%- if section.settings.eyebrow != blank -%}
      <h1 class="text-h1">{{ section.settings.eyebrow }}</h1>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h3 class="text-h3">{{ section.settings.heading | newline_to_br }}</h3>
    {%- endif -%}
  </header>

  {%- comment -%}
    Filter out entries flagged as past events — those are owned by the
    Event Slider section. `unless` catches both `false` AND unset (null) values,
    so untoggled entries default to appearing in the index.
  {%- endcomment -%}
  {%- assign all_news = shop.metaobjects.news.values -%}
  {%- assign visible_count = 0 -%}
  {%- for item in all_news -%}
    {%- unless item.add_to_previous_events -%}
      {%- assign visible_count = visible_count | plus: 1 -%}
    {%- endunless -%}
  {%- endfor -%}

  {%- if visible_count > 0 -%}
    <div class="news-index-grid">
      {%- for item in all_news -%}
        {%- unless item.add_to_previous_events -%}
          {% render 'news-card', news: item %}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="news-index-empty text-body">
      {{ 'news.index.empty' | t }}
    </p>
  {%- endif -%}
</section>

{% stylesheet %}
  /* Padding system mirrors .recipes-index: tall top inset on mobile (l) that
     steps up to xl from tablet (≥600px); inline + bottom padding scale
     separately from xs (mobile) to m (desktop). */
  .news-index {
    padding-top: var(--spacing-l);
    padding-inline: var(--spacing-xs);
    padding-bottom: var(--spacing-xs);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  @media (min-width: 600px) {
    .news-index {
      padding-top: var(--spacing-xl);
    }
  }

  @media (min-width: 900px) {
    .news-index {
      padding-inline: var(--spacing-m);
      padding-bottom: var(--spacing-m);
    }
  }

  .news-index-header {
    margin-bottom: var(--spacing-l);
  }

  .news-index-header h3 {
    max-width: 36ch;
  }

  /* News cards stack vertically — one card per row at every breakpoint.
     Hairline between entries: symmetric m padding-block on each card with a
     border-top on non-first cards puts the hairline visually centered in the
     gap between two cards. First card has no top padding/border; last card
     has no bottom padding. */
  .news-index-grid {
    display: flex;
    flex-direction: column;
  }

  .news-index-grid .news-card {
    padding-block: var(--spacing-m);
  }

  .news-index-grid .news-card:not(:first-child) {
    border-top: 1px solid var(--color-text);
  }

  .news-index-grid .news-card:first-child {
    padding-top: 0;
  }

  .news-index-grid .news-card:last-child {
    padding-bottom: 0;
  }

  .news-index-empty {
    padding: var(--spacing-l) 0;
    color: var(--color-text-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "News index",
  "tag": "section",
  "class": "news-index-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (h1 — small uppercase label)",
      "default": "News"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (h3)",
      "info": "Press Enter to add a line break.",
      "default": "What we're up to."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "News index"
    }
  ]
}
{% endschema %}
